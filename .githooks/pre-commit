#!/usr/bin/env bash
#
# pre-commit — haelt Interna aus diesem oeffentlichen Repo heraus.
#
# Einmal pro Klon aktivieren:  git config core.hooksPath .githooks
#
# Zwei Pruefungen auf den gestagten Aenderungen:
#   1. Sperrliste: eigene Kundennamen, Hosts, Ticketnummern. Die Liste liegt
#      bewusst ausserhalb des Repos (sonst waere sie selbst oeffentlich) unter
#      ${DDD_GUARD_DENYLIST:-~/.config/ddd-code-guard/denylist}, ein
#      erweiterter Regex pro Zeile, '#' leitet Kommentare ein.
#   2. gitleaks (lokal installiert oder per Docker), falls verfuegbar.
#
# Im Notfall umgehen: git commit --no-verify

set -uo pipefail

DENYLIST="${DDD_GUARD_DENYLIST:-$HOME/.config/ddd-code-guard/denylist}"
fail=0

# Nur hinzugefuegte Zeilen pruefen -- entfernte Interna sollen den Commit
# nicht blockieren, der sie gerade loescht.
added="$(git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+ ')"

if [ -f "$DENYLIST" ]; then
    while IFS= read -r pattern; do
        case "$pattern" in ''|'#'*) continue ;; esac
        hits="$(printf '%s\n' "$added" | grep -Ein -- "$pattern" || true)"
        if [ -n "$hits" ]; then
            echo "pre-commit: Sperrliste trifft '$pattern':" >&2
            printf '%s\n' "$hits" | head -5 | sed 's/^/    /' >&2
            fail=1
        fi
    done < "$DENYLIST"
else
    echo "pre-commit: keine Sperrliste unter $DENYLIST -- nur gitleaks." >&2
fi

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --no-banner --redact >&2 || fail=1
elif command -v docker >/dev/null 2>&1; then
    # Unter denselben absoluten Pfaden einhaengen: In einem Worktree ist .git nur
    # eine Datei mit einem absoluten Verweis auf das gemeinsame Git-Verzeichnis.
    # Unter /repo eingehaengt fand gitleaks kein Repository, scannte 0 Bytes und
    # meldete trotzdem Erfolg.
    root="$(git rev-parse --show-toplevel)"
    common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
    mounts=(-v "$root":"$root")
    case "$common" in
        "$root"/*) ;;
        *) mounts+=(-v "$common":"$common") ;;
    esac
    out="$(docker run --rm "${mounts[@]}" -w "$root" zricethezav/gitleaks:latest \
        git --staged --no-banner --redact "$root" 2>&1)" || fail=1
    printf '%s\n' "$out" >&2
    # Findet gitleaks kein Repository, hat es nichts geprueft -- das ist kein Erfolg.
    if printf '%s' "$out" | grep -q 'not a git repository'; then
        echo "pre-commit: gitleaks hat kein Git-Repository gefunden -- nichts geprueft." >&2
        fail=1
    fi
else
    echo "pre-commit: gitleaks nicht verfuegbar -- Secret-Scan uebersprungen." >&2
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: Commit abgebrochen. Stellen neutral formulieren." >&2
    exit 1
fi
