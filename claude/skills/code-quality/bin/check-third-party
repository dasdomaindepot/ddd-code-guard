#!/usr/bin/env python3
"""check-third-party — prüfen, ob beim ersten Seitenaufruf keine Anfrage an einen fremden Host geht.

Zweck (Regel third-party): Beim ersten Aufruf einer Seite darf keine Anfrage an einen fremden Host
gehen. Eingebettete Inhalte (Videos, Karten, Widgets) müssen per Klick nachladen (Zwei-Klick-Lösung
mit data-src), Bibliotheken und Schriften kommen vom eigenen Server.

Aufgerufen vom Code Guard (Check „third-party"), lässt sich aber auch allein fahren:
    check-third-party https://projekt.local [projektverzeichnis]

Geprüft wird der ausgelieferte HTML-Inhalt einer lokal laufenden Instanz — Was ein serverseitig
gerenderter Besucher im Quelltext sieht, nicht die clientseitig gerenderte SPA. Geprüft werden die
Startseite plus alle URLs aus sitemap.xml (nur der Pfad wird übernommen). Jede fremde Quelle, die
beim ersten Aufruf lädt, ist ein Befund ([third-party/T1]); ein Consent-Tool mildert nicht ab und
youtube-nocookie.com ist nicht ausgenommen.

Freigaben aus dem Projektprofil: Liegt <projekt>/.ai/guard-profile.yml mit
    externe_quellen:
      - host: zahlung.example
        grund: Zahlungsformular muss vom Anbieter geladen werden
vor, sind diese Hosts (exakt oder als Subdomain davon) freigegeben — statt eines Befund eine
`ok … freigegeben …`-Zeile. Eintrag ohne nicht leeren Grund wird ignoriert ([third-party/T2]).

Eigene Herkunft: Host gleich dem der geprüften Seite oder gleiche registierbare Domain (die letzten
zwei Labels; ist das vorletzte Label ko/com/org/net/gov/ac und das letzte zwei Buchstaben lang, die
letzten drei). IP-Adressen und localhost nur exakt gleich. Relative URLs und data:/blob: sind immer
eigen.

Was beim ersten Aufruf lädt und geprüft wird: <script src> mit JS-Typ, <link href> mit rel
stylesheet / preconnect / dns-prefetch / preload / modulepreload / icon, <iframe src>, <img src> und
jede URL in <img srcset>, <video src>, <audio src>, <source src> (und srcset), <object data>,
<embed src> sowie url(...) / @import in <style>-Blöcken und in Stylesheets eigener Herkunft.
loading="lazy" ändert nichts.

Was NICHT zählt: <script> mit anderem type, data-src / data-srcset ohne src, <a href>, <form action>
sowie Inline-Scripts (hier nur anhand der bekannten Anbieter-Hosts erkannt).

Exit-Codes:
     0  keine Befunde
     2  Nutzungsfehler
    77  nicht messbar (Startseite kein HTTP 200)
"""

import ipaddress
import os
import re
import ssl
import sys
from html.parser import HTMLParser
import urllib.error
import urllib.parse
import urllib.request

TIMEOUT = 15
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE  # lokale Instanzen mit mkcert/selbstsignierten Zertifikaten

MAX_PAGES = 50
try:
    MAX_PAGES = int(os.environ.get("MAX_PAGES", "50"))
except (TypeError, ValueError):
    MAX_PAGES = 50

CHECK_ID = "third-party"
RULE = ""

LOCAL_ADVICE = "lokal ausliefern"
CLICK_ADVICE = "erst nach Klick laden (Zwei-Klick-Platzhalter mit data-src)"
CLICK_ARTS = ("iframe", "video", "audio", "object", "embed")

# Bekannte Anbieter nur noch zur Namenserennung in Klammern (relevant v. a. bei Inline-Scripts).
HOST_LABELS = [
    ("Google Fonts", "fonts.googleapis.com"),
    ("Google Fonts", "fonts.gstatic.com"),
    ("Google Maps", "maps.google.com"),
    ("Google Maps", "maps.googleapis.com"),
    ("Google Maps", "www.google.com/maps"),
    ("Google Analytics/Tag Manager", "googletagmanager.com"),
    ("Google Analytics/Tag Manager", "google-analytics.com"),
    ("Meta-Pixel", "connect.facebook.net"),
    ("Hotjar", "static.hotjar.com"),
    ("Hotjar", "script.hotjar.com"),
    ("externes CDN", "cdn.jsdelivr.net"),
    ("externes CDN", "cdnjs.cloudflare.com"),
    ("externes CDN", "unpkg.com"),
    ("YouTube", "youtube.com"),
]

_CSS_FETCHED = set()
_CSS_FETCHED_COUNT = 0

# rel-Werte, bei denen ein <link href> beim ersten Aufruf eine Ausgabe auslöst.
LINK_LOAD_RELS = ("stylesheet", "preconnect", "dns-prefetch", "preload", "modulepreload", "icon")


def _rid() -> str:
    rid = f"{CHECK_ID}/{RULE}" if RULE else CHECK_ID
    # Für tests/rule-coverage.sh: welche Regel hat im Testlauf ausgelöst?
    log = os.environ.get("GUARD_RULE_LOG")
    if log:
        try:
            with open(log, "a", encoding="utf-8") as f:
                f.write(rid + "\n")
        except OSError:
            pass
    return f"[{rid}] "


def finding(msg: str) -> None:
    global RULE
    RULE = "T1"
    print("BEFUND   " + _rid() + msg)


def hint(msg: str) -> None:
    global RULE
    RULE = "T2"
    print(f"Hinweis  {_rid()}{msg}")


def ok(msg: str) -> None:
    print(f"ok       {msg}")


class PageParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.loaded_scripts: list[str] = []        # script-src, die der Browser wirklich lädt
        self.link_items: list[tuple[str, str]] = []  # (href, auslösendes rel)
        self.iframe_srcs: list[str] = []
        self.img_srcs: list[str] = []
        self.img_srcsets: list[str] = []
        self.video_srcs: list[str] = []
        self.audio_srcs: list[str] = []
        self.source_srcs: list[str] = []
        self.video_srcsets: list[str] = []
        self.audio_srcsets: list[str] = []
        self.source_srcsets: list[str] = []
        self.object_data: list[str] = []
        self.embed_srcs: list[str] = []
        self.style_bodies: list[str] = []          # Text von <style>-Blöcken
        self.inline_bodies: list[str] = []         # Text von Inline-Scripts ohne src
        self._inline: list[str] = []
        self._style: list[str] = []
        self._in_inline = False
        self._in_style = False

    @staticmethod
    def _first(attrs, name):
        for k, v in attrs:
            if k == name:
                return v
        return None

    def handle_starttag(self, tag, attrs):
        if tag == "script":
            src = self._first(attrs, "src")
            if src:
                t = (self._first(attrs, "type") or "").strip().lower()
                if t == "" or t in ("text/javascript", "module", "application/javascript"):
                    self.loaded_scripts.append(src)
            else:
                # Nur ausgeführtes JavaScript zählt. JSON-LD (application/ld+json),
                # Templates und text/plain enthalten zwar URLs, laden aber nichts –
                # etwa "sameAs": ["https://www.youtube.com/@kanal"] in Strukturdaten.
                t = (self._first(attrs, "type") or "").strip().lower()
                if t == "" or t in ("text/javascript", "module", "application/javascript"):
                    self._in_inline = True
                    self._inline = []
        elif tag == "style":
            self._in_style = True
            self._style = []
        elif tag == "iframe":
            src = self._first(attrs, "src")
            if src:
                self.iframe_srcs.append(src)
        elif tag == "img":
            src = self._first(attrs, "src")
            if src:
                self.img_srcs.append(src)
            srcset = self._first(attrs, "srcset")
            if srcset:
                self.img_srcsets.append(srcset)
        elif tag == "link":
            href = self._first(attrs, "href")
            if not href:
                return
            rels = (self._first(attrs, "rel") or "").lower().split()
            for rel in LINK_LOAD_RELS:
                if rel in rels:
                    self.link_items.append((href, rel))
                    break
        elif tag in ("video", "audio"):
            src = self._first(attrs, "src")
            if src:
                (self.video_srcs if tag == "video" else self.audio_srcs).append(src)
            srcset = self._first(attrs, "srcset")
            if srcset:
                (self.video_srcsets if tag == "video" else self.audio_srcsets).append(srcset)
        elif tag == "source":
            src = self._first(attrs, "src")
            if src:
                self.source_srcs.append(src)
            srcset = self._first(attrs, "srcset")
            if srcset:
                self.source_srcsets.append(srcset)
        elif tag == "object":
            data = self._first(attrs, "data")
            if data:
                self.object_data.append(data)
        elif tag == "embed":
            src = self._first(attrs, "src")
            if src:
                self.embed_srcs.append(src)

    def handle_data(self, data) -> None:
        if self._in_inline:
            self._inline.append(data)
        elif self._in_style:
            self._style.append(data)

    def handle_endtag(self, tag) -> None:
        if tag == "script" and self._in_inline:
            self._in_inline = False
            self.inline_bodies.append("".join(self._inline))
        elif tag == "style" and self._in_style:
            self._in_style = False
            self.style_bodies.append("".join(self._style))


def fetch(url: str) -> tuple[int, str, str]:
    """(Status, Content-Type, Body). Folgt Weiterleitungen."""
    req = urllib.request.Request(url, headers={"User-Agent": "code-guard-third-party"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT, context=CTX) as r:
            ct = r.headers.get("Content-Type", "")
            return r.status, ct, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, "", ""
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        return 0, "", ""


def host_of(url: str) -> str:
    try:
        return (urllib.parse.urlparse(url).hostname or "").lower()
    except Exception:
        return ""


def is_ip(host: str) -> bool:
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def registrable_domain(host: str) -> str:
    """Registrierbare Domain eines Hosts (letzte zwei Labels, bei 2-Teilchen-TLD die letzten drei)."""
    labels = host.split(".")
    if len(labels) < 2:
        return host
    if labels[-2] in ("co", "com", "org", "net", "gov", "ac") and len(labels[-1]) == 2:
        return ".".join(labels[-3:])
    return ".".join(labels[-2:])


def own_host(url: str, page_host: str, page_special: bool) -> bool:
    """True, wenn die URL vom eigenen Server kommt (eigene Herkunft)."""
    try:
        parts = urllib.parse.urlsplit(url)
    except Exception:
        return False
    host = (parts.hostname or "").lower()
    if host == "":  # relative URL, data: oder blob:
        return True
    if host == page_host:  # exakt gleich (Deckung mit IP/localhost)
        return True
    if page_special or is_ip(host) or host == "localhost":
        return False
    return registrable_domain(host) == registrable_domain(page_host)


def provider_for(url: str):
    """Label eines bekannten Anbieters für eine URL, sonst None — nur zur Namenserennung."""
    try:
        u = urllib.parse.urlparse(url)
    except Exception:
        return None
    host = (u.hostname or "").lower()
    path = u.path or ""
    if host.endswith(("fonts.googleapis.com", "fonts.gstatic.com")):
        return "Google Fonts"
    if (host == "maps.google.com" or host.endswith("maps.googleapis.com")
            or (host == "www.google.com" and path.startswith("/maps"))):
        return "Google Maps"
    if host.endswith("googletagmanager.com") or host.endswith("google-analytics.com"):
        return "Google Analytics/Tag Manager"
    if host.endswith("connect.facebook.net"):
        return "Meta-Pixel"
    if host.endswith(("static.hotjar.com", "script.hotjar.com")):
        return "Hotjar"
    if host.endswith(("cdn.jsdelivr.net", "cdnjs.cloudflare.com", "unpkg.com")):
        return "externes CDN"
    if host.endswith("youtube.com"):
        return "YouTube"
    return None


def css_urls(css_text: str) -> list[tuple[str, str]]:
    """(Art, URL) für @import url(…)/„…" und url(…) in einem Stylesheet, Dedup in Erhalt."""
    out: list[tuple[str, str]] = []
    seen: set[str] = set()
    for m in re.findall(r"""@import\s+(?:url\(\s*|['"])([^'")\s]+)""", css_text, re.I):
        u = m.strip()
        if u not in seen:
            seen.add(u)
            out.append(("@import", u))
    for m in re.findall(r"""url\(\s*(['"]?)([^'")\s]+)\1\s*\)""", css_text):
        u = m[1]
        if u not in seen:
            seen.add(u)
            out.append(("url", u))
    return out


def parse_srcset(srcset: str) -> list[str]:
    """Erste URL je Komma-Eintrag einer srcset-Liste."""
    urls: list[str] = []
    for part in srcset.split(","):
        part = part.strip()
        if not part:
            continue
        urls.append(part.split()[0])
    return urls


def _fetch_own_css(abs_url: str, css_display: str, path: str, base: str, page_host: str,
                   page_special: bool, findings: list[dict]) -> None:
    """Ein gleich-origin Stylesheet holen, fremde @import/url finden, eigenen @import folgen."""
    global _CSS_FETCHED_COUNT
    if abs_url in _CSS_FETCHED or _CSS_FETCHED_COUNT >= 20:
        return
    status, _, body = fetch(abs_url)
    if status != 200:
        return
    _CSS_FETCHED.add(abs_url)
    _CSS_FETCHED_COUNT += 1
    origin_scheme, origin_netloc = urllib.parse.urlsplit(base)[0], urllib.parse.urlsplit(base)[1]
    for desc, url in css_urls(body):
        if not own_host(url, page_host, page_special):
            art = "@import" if desc == "@import" else "url"
            findings.append({"host": host_of(url), "art": art,
                             "ctx": f"über {css_display}", "provider": provider_for(url)})
        elif desc == "@import":
            next_url = urllib.parse.urljoin(abs_url, url)
            ns, nl = urllib.parse.urlsplit(next_url)[:2]
            if ns == origin_scheme and nl == origin_netloc:
                _fetch_own_css(next_url, urllib.parse.urlsplit(next_url).path, path, base,
                               page_host, page_special, findings)


def analyze_page(p: PageParser, path: str, base: str, page_host: str, page_special: bool) -> list[dict]:
    """Fremde Quellen (Art, Host, Kontext) auflisten, die beim ersten Aufruf laden."""
    findings: list[dict] = []
    origin_scheme, origin_netloc = urllib.parse.urlsplit(base)[0], urllib.parse.urlsplit(base)[1]

    def add(url: str, art: str, ctx: str = "") -> None:
        if own_host(url, page_host, page_special):
            return
        findings.append({"host": host_of(url), "art": art, "ctx": ctx, "provider": provider_for(url)})

    for href, rel in p.link_items:
        add(href, f"link {rel}")

    for src in p.loaded_scripts:
        add(src, "script")

    for src in p.iframe_srcs:
        add(src, "iframe")

    for src in p.img_srcs:
        add(src, "img")
    for srcset in p.img_srcsets:
        for src in parse_srcset(srcset):
            add(src, "srcset")

    for src in p.video_srcs:
        add(src, "video")
    for src in p.video_srcsets:
        add(src, "video")
    for src in p.audio_srcs:
        add(src, "audio")
    for src in p.audio_srcsets:
        add(src, "audio")
    for src in p.source_srcs:
        add(src, "source")
    for src in p.source_srcsets:
        add(src, "source")
    for data in p.object_data:
        add(data, "object")
    for src in p.embed_srcs:
        add(src, "embed")

    for body in p.style_bodies:
        for desc, url in css_urls(body):
            if not own_host(url, page_host, page_special):
                art = "@import" if desc == "@import" else "url"
                findings.append({"host": host_of(url), "art": art,
                                 "ctx": "im <style>-Block", "provider": provider_for(url)})

    for body in p.inline_bodies:
        bl = body.lower()
        for label, suffix in HOST_LABELS:
            if suffix in bl:
                findings.append({"host": suffix, "art": "Inline-Script", "ctx": "",
                                 "provider": label})

    for href, rel in p.link_items:
        if rel != "stylesheet":
            continue
        abs_url = urllib.parse.urljoin(base + "/", href)
        ns, nl = urllib.parse.urlsplit(abs_url)[:2]
        if ns == origin_scheme and nl == origin_netloc:
            _fetch_own_css(abs_url, urllib.parse.urlsplit(abs_url).path, path, base,
                           page_host, page_special, findings)

    return findings


def load_allowlist(project_path: str) -> tuple[dict[str, str], list[str]]:
    """({host: grund}, [host ohne Grund]) aus <projekt>/.ai/guard-profile.yml. PyYAML fehlt → Hinweis."""
    allowdict: dict[str, str] = {}
    no_grund: list[str] = []
    if not project_path:
        return allowdict, no_grund
    yml = os.path.join(project_path, ".ai", "guard-profile.yml")
    if not os.path.isfile(yml):
        return allowdict, no_grund
    global RULE
    RULE = "T2"
    try:
        import yaml
    except Exception:
        hint("PyYAML fehlt – Freigaben aus .ai/guard-profile.yml nicht gelesen")
        return allowdict, no_grund
    try:
        with open(yml, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except Exception:
        hint(".ai/guard-profile.yml nicht lesbar – Freigaben nicht berücksichtigt")
        return allowdict, no_grund
    if not isinstance(data, dict):
        return allowdict, no_grund
    items = data.get("externe_quellen") or []
    if not isinstance(items, list):
        return allowdict, no_grund
    for item in items:
        if not isinstance(item, dict):
            continue
        host = (item.get("host") or "").strip().lower().rstrip(".")
        if not host:
            continue
        grund = (item.get("grund") or "").strip()
        if not grund:
            no_grund.append(host)
            continue
        allowdict[host] = grund
    return allowdict, no_grund


def allowed_grund(host: str, allowdict: dict[str, str]):
    """Grund, wenn host (exakt oder Subdomain) freigegeben ist, sonst None."""
    for base_host, grund in allowdict.items():
        if host == base_host or host.endswith("." + base_host):
            return grund
    return None


def format_pages(pages: list[str]) -> str:
    if len(pages) <= 3:
        return ", ".join(pages)
    return ", ".join(pages[:3]) + f" und {len(pages) - 3} weiteren Seiten"


def main() -> int:
    global RULE
    if len(sys.argv) not in (2, 3):
        print("Verwendung: check-third-party <https://lokale-url> [projektverzeichnis]",
              file=sys.stderr)
        return 2
    base = sys.argv[1].rstrip("/")
    project_path = sys.argv[2].rstrip("/") if len(sys.argv) == 3 else ""

    status, _, _ = fetch(base + "/")
    if status != 200:
        print(f"Startseite {base}/ liefert HTTP {status} — Instanz läuft nicht oder ist nicht die App.")
        return 77

    page_host = host_of(base)
    page_special = is_ip(page_host) or page_host == "localhost"

    allowdict, no_grund = load_allowlist(project_path)

    # host → Aggregat über alle Seiten
    agg: dict[str, dict] = {}
    freed: dict[str, str] = {}

    for path in collect_paths(base):
        status, ct, body = fetch(base + path)
        if status != 200 or "text/html" not in ct.lower():
            continue
        p = PageParser()
        p.feed(body)
        for f in analyze_page(p, path, base, page_host, page_special):
            host = f["host"]
            if not host:
                continue
            grund = allowed_grund(host, allowdict)
            if grund is not None:
                freed.setdefault(host, grund)
                continue
            info = agg.get(host)
            if info is None:
                info = {"pages": [], "arts": [], "click": False, "provider": None, "ctx": ""}
                agg[host] = info
            if path not in info["pages"]:
                info["pages"].append(path)
            if f["art"] not in info["arts"]:
                info["arts"].append(f["art"])
            if f["art"] in CLICK_ARTS:
                info["click"] = True
            if info["provider"] is None and f["provider"]:
                info["provider"] = f["provider"]
            if not info["ctx"] and f["ctx"]:
                info["ctx"] = f["ctx"]

    for host in sorted(no_grund):
        hint(f"Freigabe für {host} ohne Grund – wird nicht berücksichtigt")

    RULE = "T1"
    befunds = 0
    for host in sorted(agg):
        info = agg[host]
        paren = f" ({info['provider']})" if info["provider"] else ""
        art_str = ", ".join(info["arts"])
        advice = CLICK_ADVICE if info["click"] else LOCAL_ADVICE
        ctx = f"{info['ctx']} " if info["ctx"] else ""
        print(f"BEFUND   {_rid()}{host}{paren} {ctx}lädt beim ersten Aufruf – auf "
              f"{format_pages(info['pages'])} ({art_str}) — {advice}")
        befunds += 1

    for host in sorted(freed):
        ok(f"fremde Quelle {host} freigegeben: {freed[host]}")

    if befunds == 0 and not freed:
        ok("keine fremden Quellen beim ersten Aufruf")

    return 1 if befunds else 0


def collect_paths(base: str) -> list[str]:
    paths: list[str] = []
    seen: set[str] = set()

    def add(path: str) -> None:
        if path not in seen:
            seen.add(path)
            paths.append(path)

    add("/")
    status, _, sitemap = fetch(base + "/sitemap.xml")
    if status == 200:
        for loc in re.findall(r"<loc>\s*([^<]+?)\s*</loc>", sitemap):
            add(urllib.parse.urlparse(loc.strip()).path or "/")
    return paths[:MAX_PAGES]


if __name__ == "__main__":
    sys.exit(main())
