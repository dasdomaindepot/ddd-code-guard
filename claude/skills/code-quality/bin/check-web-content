#!/usr/bin/env python3
"""check-web-content — Server-seitig gerenderten Inhalt einer lokal laufenden Instanz auf Grund-
gerüst und Barrierefreiheit prüfen.

Aufgerufen vom Code Guard (Check "web-content"), lässt sich aber auch allein fahren:
    check-web-content https://projekt.local

Geprüft wird der ausgelieferte HTML-Inhalt, nicht die gerenderte SPA: Was im
Quelltext steht, sieht ein serverseitig gerenderter Besucher. Clientseitig
gerenderte Seiten (Vue/React …) ohne sichtbaren Inhalt im <body> sind nicht
messbar und werden übergangen.

Geprüft werden die Startseite plus alle URLs aus sitemap.xml (Host wird auf die
lokale Instanz umgeschrieben). Jede Verletzung ist ein Befund:
   1. <html> hat ein nicht leeres lang-Attribut.
   2. <title> vorhanden und nach strip() nicht leer.
   3. <meta name="description"> vorhanden, content nicht leer.
   4. <link rel="canonical"> vorhanden, href nicht leer.
   5. <meta name="viewport"> vorhanden.
   6. viewport verbietet kein Zoomen (kein user-scalable=no/0, kein maximum-scale < 2).
      (3. und 4. entfallen bei <meta name="robots" content="noindex">.)
   7. Genau ein <h1> mit nicht leerem Text.
   8. Jedes <img> hat ein alt-Attribut (alt="" erlaubt, dekorativ).
   9. alt ist kein Dateiname oder Platzhalter.
  10. Jeder <a href> und jeder <button> hat einen zugänglichen Namen.
  11. jedes Formularfeld hat eine Beschriftung.
  12. Kein id-Wert kommt mehrfach vor.

Ignoriert werden <script>, <style>, <template>, <noscript> sowie die
Symfony-Debug-Toolbar (id mit sfwdt/sfToolbar oder class sf-toolbar) — sie wird
im Dev-Modus injiziert und ist nicht Teil der App — und alles mit hidden oder
aria-hidden="true" (für Screenreader unsichtbar, z. B. ein Honeypot-Feld). HTML wird mit
html.parser.HTMLParser geparst, nicht mit Regex.

Nur lesende GET-Anfragen, ausschließlich gegen die übergebene URL.

Exit-Codes:
    0  keine Befunde
    1  Befunde
    2  Nutzungsfehler
   77  nicht messbar (Startseite kein HTTP 200 oder keine serverseitig gerenderte Seite)
"""

import json
import os
import re
import ssl
import sys
from html.parser import HTMLParser
import urllib.error
import urllib.parse
import urllib.request

TIMEOUT = 15
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE  # lokale Instanzen mit mkcert/selbstsignierten Zertifikaten

VOID_ELEMENTS = {"img", "input", "br", "meta", "link", "hr", "source", "area", "wbr"}
IGNORE_TAGS = {"script", "style", "template", "noscript"}

findings = 0
MAX_PAGES = 50
try:
    MAX_PAGES = int(os.environ.get("MAX_PAGES", "50"))
except (TypeError, ValueError):
    MAX_PAGES = 50


def finding(msg: str) -> None:
    global findings
    findings += 1
    print(f"BEFUND   {msg}")


def ok(msg: str) -> None:
    print(f"ok       {msg}")


def hint(msg: str) -> None:
    print(f"Hinweis  {msg}")


def fetch(url: str) -> tuple[int, str, str]:
    """(Status, Content-Type, Body). Folgt Weiterleitungen."""
    req = urllib.request.Request(url, headers={"User-Agent": "code-guard-web-content"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT, context=CTX) as r:
            ct = r.headers.get("Content-Type", "")
            return r.status, ct, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, "", ""
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        return 0, "", ""


def is_placeholder_alt(alt: str) -> bool:
    a = alt.strip().lower()
    if a.endswith((".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".svg")):
        return True
    return a in {"image", "img", "bild", "foto", "photo", "picture", "grafik"}


def zoom_text(content: str) -> str:
    c = content.lower()
    if "user-scalable=no" in c:
        return "(user-scalable=no)"
    if "user-scalable=0" in c:
        return "(user-scalable=0)"
    m = re.search(r"maximum-scale\s*=\s*([0-9.]+)", c)
    if m and float(m.group(1)) < 2:
        return f"(maximum-scale={m.group(1)})"
    return ""


class PageParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        # Ignorierter Bereich (script/style/Toolbar …): Tag und Verschachtelungstiefe.
        # Die Toolbar besteht aus vielen verschachtelten <div>; das erste </div>
        # darf den Bereich nicht beenden.
        self.ignore_tag: str | None = None
        self.ignore_depth = 0
        self.text_stack: list[dict] = []   # pro Element: Tag, Text, Namens-Flaggen
        self.in_label = 0                  # Tiefe innerhalb eines <label>
        self.in_body = False

        self.lang: str | None = None
        self.title_text = ""
        self.has_title = False
        self.has_meta_description = False
        self.meta_description_content: str | None = None
        self.noindex = False
        self.has_viewport = False
        self.viewport_content: str | None = None
        self.has_canonical = False
        self.canonical_href: str | None = None
        self.h1_texts: list[str] = []
        self.images: list[tuple[str | None, str | None]] = []
        self.fields: list[dict] = []
        self.labels_for: set[str] = set()
        self.ids: list[str] = []
        self.accessible_missing: list[str] = []
        self.body_text = ""
        # Regeln 13–19 und Hinweise
        self.mains = 0
        self.headings: list[tuple[int, str]] = []
        self.first_links: list[str] = []
        self.resources: list[tuple[str, str]] = []   # (Art, URL) für Mixed Content
        self.ld_json: list[str] = []
        self._ld_buffer: list[str] | None = None
        self.pw_autocomplete_off = 0
        self.pw_onpaste = 0
        self.personal_no_autocomplete: list[str] = []

    # -- Hilfsfunktionen -------------------------------------------------

    @staticmethod
    def _first(attrs, name):
        for k, v in attrs:
            if k == name:
                return v
        return None

    def _collect_ids(self, attrs) -> None:
        for k, v in attrs:
            if k == "id" and v:
                self.ids.append(v)

    def _is_ignored(self, tag: str, attrs) -> bool:
        """Symfony-Toolbar oder für assistive Technik unsichtbar (hidden, aria-hidden).

        Ein Honeypot-Feld gehört in ein Element mit aria-hidden="true" — dann liest es
        auch kein Screenreader vor und es braucht kein Label.
        """
        aid = self._first(attrs, "id") or ""
        cls = self._first(attrs, "class") or ""
        if aid.startswith("sfwdt") or aid.startswith("sfToolbar"):
            return True
        if any(k == "hidden" for k, _ in attrs):
            return True
        if (self._first(attrs, "aria-hidden") or "").strip().lower() == "true":
            return True
        return "sf-toolbar" in cls.split()

    def _record_self(self, tag: str, attrs, entry: dict) -> None:
        for k in ("aria-label", "aria-labelledby", "title"):
            v = self._first(attrs, k)
            if v is not None and v.strip():
                entry["self_name"] = True
        if tag == "a":
            entry["href"] = self._first(attrs, "href")
        if tag == "svg" and (v := self._first(attrs, "aria-label")) is not None and v.strip():
            entry["svg_title"] = True

    def _add_field(self, attrs, tag: str) -> None:
        self.fields.append({
            "name": self._first(attrs, "name"),
            "id": self._first(attrs, "id"),
            "tag": tag,
            "wrapped": self.in_label > 0,
            "has_attr_label": any(self._first(attrs, k) for k in
                                  ("aria-label", "aria-labelledby", "title")),
        })

    def _accessible(self, entry: dict) -> bool:
        if entry["self_name"]:
            return True
        if "".join(entry["text"]).strip():
            return True
        if entry["img_alt"]:
            return True
        if entry["svg_title"]:
            return True
        return False

    # -- Start-Tags ------------------------------------------------------

    def handle_starttag(self, tag, attrs):
        self._on_start(tag, attrs, False)

    def handle_startendtag(self, tag, attrs):
        self._on_start(tag, attrs, True)

    def _on_start(self, tag, attrs, self_closed) -> None:
        if self.ignore_tag is not None:
            if tag == self.ignore_tag and not self_closed:
                self.ignore_depth += 1
            return
        if tag == "script" and not self._is_ignored(tag, attrs):
            if self._first(attrs, "src"):
                self.resources.append(("script", self._first(attrs, "src")))
            if (self._first(attrs, "type") or "").strip().lower() == "application/ld+json":
                self._ld_buffer = []
        if not self_closed and tag not in VOID_ELEMENTS and (tag in IGNORE_TAGS or self._is_ignored(tag, attrs)):
            self.ignore_tag = tag
            self.ignore_depth = 1
            return
        if tag in VOID_ELEMENTS or self_closed:
            self._on_void(tag, attrs)
            return
        self._collect_ids(attrs)
        entry = {"tag": tag, "text": [], "img_alt": False, "svg_title": False, "self_name": False, "href": None}
        self.text_stack.append(entry)
        self._record_self(tag, attrs, entry)
        if tag == "main" or (self._first(attrs, "role") or "").lower() == "main":
            self.mains += 1
        if tag == "a" and self._first(attrs, "href") is not None and len(self.first_links) < 3:
            self.first_links.append(self._first(attrs, "href"))
        if tag in ("iframe", "video", "audio") and self._first(attrs, "src"):
            self.resources.append((tag, self._first(attrs, "src")))
        if tag == "form" and self._first(attrs, "action"):
            self.resources.append(("form", self._first(attrs, "action")))
        if tag == "body":
            self.in_body = True
        elif tag == "html":
            self.lang = self._first(attrs, "lang")
        elif tag == "title" and not self.in_body:
            self.has_title = True
        elif tag == "label":
            self.in_label += 1
            for k, v in attrs:
                if k == "for" and v is not None:
                    self.labels_for.add(v)
        elif tag in ("select", "textarea"):
            self._add_field(attrs, tag)

    def _on_void(self, tag, attrs) -> None:
        self._collect_ids(attrs)
        if tag == "img":
            src = self._first(attrs, "src")
            alt = self._first(attrs, "alt")
            self.images.append((src, alt))
            if src:
                self.resources.append(("img", src))
            if self.text_stack and alt is not None and alt.strip():
                self.text_stack[-1]["img_alt"] = True
        elif tag == "input":
            t = (self._first(attrs, "type") or "").lower()
            if t not in ("hidden", "submit", "button", "reset", "image"):
                self._add_field(attrs, "input")
            if t == "password":
                if (self._first(attrs, "autocomplete") or "").strip().lower() == "off":
                    self.pw_autocomplete_off += 1
                if any(k == "onpaste" for k, _ in attrs):
                    self.pw_onpaste += 1
            name = (self._first(attrs, "name") or "").lower()
            if (t in ("email", "tel") or PERSONAL_RE.search(name)) and self._first(attrs, "autocomplete") is None \
                    and t not in ("hidden", "submit", "button", "reset", "image", "checkbox", "radio", "password"):
                self.personal_no_autocomplete.append(self._first(attrs, "name") or t)
        elif tag == "meta":
            name = (self._first(attrs, "name") or "").lower()
            if name == "description":
                self.has_meta_description = True
                self.meta_description_content = self._first(attrs, "content")
            elif name == "robots":
                self.noindex = "noindex" in (self._first(attrs, "content") or "").lower()
            elif name == "viewport":
                self.has_viewport = True
                self.viewport_content = self._first(attrs, "content")
        elif tag == "source" and self._first(attrs, "src"):
            self.resources.append(("source", self._first(attrs, "src")))
        elif tag == "link":
            rel = (self._first(attrs, "rel") or "").lower()
            if "stylesheet" in rel.split() and self._first(attrs, "href"):
                self.resources.append(("stylesheet", self._first(attrs, "href")))
            if "canonical" in rel.split():
                self.has_canonical = True
                self.canonical_href = self._first(attrs, "href")

    # -- Daten -----------------------------------------------------------

    def handle_data(self, data) -> None:
        if self.ignore_tag is not None:
            if self.ignore_tag == "script" and self._ld_buffer is not None:
                self._ld_buffer.append(data)
            return
        if self.text_stack:
            self.text_stack[-1]["text"].append(data)
        if self.in_body:
            self.body_text += data

    def handle_endtag(self, tag) -> None:
        if self.ignore_tag is not None:
            if tag == self.ignore_tag:
                self.ignore_depth -= 1
                if self.ignore_depth == 0:
                    if tag == "script" and self._ld_buffer is not None:
                        self.ld_json.append("".join(self._ld_buffer))
                        self._ld_buffer = None
                    self.ignore_tag = None
            return
        if tag in VOID_ELEMENTS:
            return
        # HTML erlaubt offene Elemente (<p>, <li> …): bis zum passenden Start-Tag
        # schließen, sonst gerät die Zuordnung von Text zu Link/Button durcheinander.
        # Ein End-Tag ohne Start-Tag wird übergangen.
        if not any(e["tag"] == tag for e in self.text_stack):
            return
        while self.text_stack[-1]["tag"] != tag:
            self._close(self.text_stack.pop())
        self._close(self.text_stack.pop())

    def _close(self, entry: dict) -> None:
        tag = entry["tag"]
        if tag == "body":
            self.in_body = False
        elif tag == "label":
            self.in_label = max(0, self.in_label - 1)
        elif tag == "title":
            if not self.in_body:
                self.title_text = "".join(entry["text"])
            elif self.text_stack:
                self.text_stack[-1]["svg_title"] = True
        elif tag == "h1":
            self.h1_texts.append("".join(entry["text"]))
        if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
            self.headings.append((int(tag[1]), " ".join("".join(entry["text"]).split())))
        elif tag == "a":
            href = entry["href"]
            if href and not self._accessible(entry):
                self.accessible_missing.append(href or "<a>")
        elif tag == "button":
            if not self._accessible(entry):
                self.accessible_missing.append("<button>")
        if self.text_stack:
            parent = self.text_stack[-1]
            parent["text"].extend(entry["text"])
            parent["img_alt"] = parent["img_alt"] or entry["img_alt"]
            parent["svg_title"] = parent["svg_title"] or entry["svg_title"]
            parent["self_name"] = parent["self_name"] or entry["self_name"]

    def visible(self) -> bool:
        return bool(self.body_text.strip())


PERSONAL_RE = re.compile(r"email|phone|telefon|vorname|nachname|firstname|lastname|street|strasse|straße|plz|zip")
DOCTYPE_RE = re.compile(r"^\ufeff?\s*(?:<!--.*?-->\s*)*<!doctype\s+html\s*>", re.I | re.S)
CHARSET_RE = re.compile(r"<meta[^>]+charset\s*=\s*[\"']?\s*utf-?8", re.I)

skip_link_reported = False


def mixed_content(p: "PageParser") -> list[tuple[str, str]]:
    """Unverschlüsselt geladene Ressourcen und Formularziele einer https-Seite."""
    return [(kind, url) for kind, url in p.resources if url.strip().lower().startswith("http://")]


def ld_json_problems(blocks: list[str]) -> list[str]:
    problems = []
    for raw in blocks:
        try:
            data = json.loads(raw)
        except ValueError as e:
            problems.append(f"JSON-LD ist kein gültiges JSON ({e})")
            continue
        items = data if isinstance(data, list) else [data]
        for item in items:
            if not isinstance(item, dict):
                continue
            if "@context" not in item and not isinstance(data, list):
                problems.append("JSON-LD ohne @context")
            if "@graph" in item:
                if any(isinstance(g, dict) and "@type" not in g for g in item["@graph"]):
                    problems.append("JSON-LD ohne @type (im @graph)")
            elif "@type" not in item:
                problems.append("JSON-LD ohne @type")
    return problems


def _examples(items, limit=5) -> str:
    if len(items) <= limit:
        return ", ".join(items)
    return ", ".join(items[:limit]) + ", …"


def check_page(path: str, p: PageParser, raw: str = "", https: bool = False) -> None:
    # 1. lang
    if p.lang is None or not p.lang.strip():
        finding(f"{path}: <html> ohne lang-Attribut")
    # 2. title
    if not p.has_title or not p.title_text.strip():
        finding(f"{path}: <title> fehlt oder ist leer")
    # 3./4. Nur für indexierbare Seiten: Eine Seite mit <meta name="robots"
    # content="noindex"> (Login, interne App) braucht weder Description noch
    # Canonical. Der X-Robots-Tag-Header zählt bewusst nicht — Symfony setzt ihn
    # im Debug-Modus auf jede Antwort.
    if p.noindex:
        pass
    # 3. description
    elif not p.has_meta_description or not (p.meta_description_content or "").strip():
        finding(f'{path}: <meta name="description"> fehlt oder ist leer')
    # 4. canonical
    if not p.noindex and (not p.has_canonical or not (p.canonical_href or "").strip()):
        finding(f'{path}: <link rel="canonical"> fehlt')
    # 5. viewport
    if not p.has_viewport:
        finding(f'{path}: <meta name="viewport"> fehlt')
    # 6. Zoom
    elif zoom_text(p.viewport_content or ""):
        finding(f"{path}: viewport verbietet das Zoomen {zoom_text(p.viewport_content or '')}")
    # 7. h1
    if not p.h1_texts:
        finding(f"{path}: <h1> fehlt")
    elif len(p.h1_texts) > 1:
        finding(f"{path}: {len(p.h1_texts)} <h1> statt genau einem")
    elif not p.h1_texts[0].strip():
        finding(f"{path}: <h1> ist leer")
    # 8. img ohne alt
    no_alt = [src if src else "(kein src)" for src, alt in p.images if alt is None]
    if no_alt:
        finding(f"{path}: {len(no_alt)} Bild(er) ohne alt-Attribut: {_examples(no_alt)}")
    # 9. alt als Platzhalter
    ph = [alt for src, alt in p.images if alt is not None and is_placeholder_alt(alt)]
    if ph:
        finding(f"{path}: {len(ph)} Bild(er) mit Platzhalter als alt-Text: {_examples(ph)}")
    # 10. zugänglicher Name
    if p.accessible_missing:
        finding(f"{path}: {len(p.accessible_missing)} Link(s)/Button(s) ohne zugänglichen Namen: {_examples(p.accessible_missing)}")
    # 11. Formularfelder ohne Label
    missing_label = []
    for f in p.fields:
        has_label = f["has_attr_label"] or f["wrapped"] or (f["id"] in p.labels_for)
        if not has_label:
            missing_label.append(f["name"] if f["name"] else (f["id"] or f["tag"]))
    if missing_label:
        finding(f"{path}: {len(missing_label)} Formularfeld(er) ohne Label: {_examples(missing_label)}")
    # 12. doppelte ids
    seen_ids: dict[str, int] = {}
    for i in p.ids:
        seen_ids[i] = seen_ids.get(i, 0) + 1
    dups = [k for k, n in seen_ids.items() if n > 1]
    if dups:
        finding(f"{path}: doppelte id: {_examples(dups)}")
    # 13. Doctype
    if not DOCTYPE_RE.search(raw):
        finding(f"{path}: <!DOCTYPE html> fehlt am Anfang")
    # 14. Zeichensatz
    m = CHARSET_RE.search(raw)
    if not m:
        finding(f'{path}: <meta charset="utf-8"> fehlt')
    elif m.start() > 1024:
        finding(f"{path}: <meta charset> steht nicht in den ersten 1024 Bytes")
    # 15. Mixed Content
    if https:
        mixed = mixed_content(p)
        forms = [u for k, u in mixed if k == "form"]
        loads = [u for k, u in mixed if k != "form"]
        if loads:
            finding(f"{path}: lädt {_examples(loads, 3)} über unverschlüsseltes HTTP (Mixed Content)")
        if forms:
            finding(f"{path}: Formular sendet an {_examples(forms, 3)} (unverschlüsselt)")
    # 16. Hauptbereich
    if p.mains == 0:
        finding(f"{path}: kein <main>-Bereich")
    elif p.mains > 1:
        finding(f"{path}: {p.mains} <main>-Bereiche statt einem")
    # 17. Passwortfelder
    if p.pw_autocomplete_off:
        finding(f'{path}: Passwortfeld mit autocomplete="off" — blockiert Passwortmanager (ASVS 6.2.7)')
    if p.pw_onpaste:
        finding(f"{path}: Passwortfeld verbietet Einfügen (onpaste)")
    # 18. JSON-LD
    for problem in ld_json_problems(p.ld_json):
        finding(f"{path}: {problem}")
    # H1 Skip-Link — gemeinsames Layout, deshalb nur einmal pro Lauf
    global skip_link_reported
    ids = set(p.ids)
    if not skip_link_reported and not any(h.startswith("#") and h[1:] in ids for h in p.first_links):
        skip_link_reported = True
        hint(f"{path}: kein Skip-Link („Zum Inhalt springen“) vor der Navigation")
    # H2 Überschriften-Sprünge
    for (a, _), (b, text) in zip(p.headings, p.headings[1:]):
        if b > a + 1:
            hint(f"{path}: Überschrift springt von h{a} auf h{b} („{text[:50]}“)")
            break
    # H3 autocomplete für persönliche Daten (WCAG 1.3.5)
    if p.personal_no_autocomplete:
        n = len(p.personal_no_autocomplete)
        hint(f"{path}: {n} Feld(er) für persönliche Daten ohne autocomplete: {_examples(p.personal_no_autocomplete, 3)} (WCAG 1.3.5)")


def collect_paths(base: str) -> tuple[list[str], int]:
    paths: list[str] = []
    seen: set[str] = set()

    def add(path: str) -> None:
        if path not in seen:
            seen.add(path)
            paths.append(path)

    add("/")
    status, _, sitemap = fetch(base + "/sitemap.xml")
    if status == 200:
        if "sitemapindex" in sitemap.lower():
            hint("sitemap.xml ist ein Sitemap-Index — Unter-Sitemaps werden nicht verfolgt")
        else:
            for loc in re.findall(r"<loc>\s*([^<]+?)\s*</loc>", sitemap):
                add(urllib.parse.urlparse(loc.strip()).path or "/")
    total = len(paths)
    return paths[:MAX_PAGES], total


def main() -> int:
    if len(sys.argv) != 2:
        print("Verwendung: check-web-content <https://lokale-url>", file=sys.stderr)
        return 2
    base = sys.argv[1].rstrip("/")

    # Wie check-legal: Ohne 200 auf / antwortet evtl. nur ein Catch-all des
    # Reverse-Proxys — dann messen wir nicht die App.
    status, _, _ = fetch(base + "/")
    if status != 200:
        print(f"Startseite {base}/ liefert HTTP {status} — Instanz läuft nicht oder ist nicht die App.")
        return 77

    paths, total = collect_paths(base)
    if total > len(paths):
        hint(f"{len(paths)} von {total} Seiten geprüft (MAX_PAGES)")

    https = base.lower().startswith("https://")
    titles: dict[str, list[str]] = {}
    descriptions: dict[str, list[str]] = {}
    any_server_rendered = False
    for path in paths:
        status, ct, body = fetch(base + path)
        if status != 200 or "text/html" not in ct.lower():
            continue
        p = PageParser()
        p.feed(body)
        if not p.visible():
            hint(f"{path}: kein serverseitig gerenderter Inhalt (SPA?) — nicht messbar")
            continue
        any_server_rendered = True
        before = findings
        check_page(path, p, body, https)
        if not p.noindex:
            t = " ".join(p.title_text.split())
            if t:
                titles.setdefault(t, []).append(path)
            d = " ".join((p.meta_description_content or "").split())
            if d:
                descriptions.setdefault(d, []).append(path)
        if findings == before:
            ok(f"{path}: Grundgerüst, Überschriften, Bilder, Links und Formulare in Ordnung")

    if not any_server_rendered:
        print("Keine serverseitig gerenderte Seite erreichbar — nicht messbar.")
        return 77

    # 19. Titel und Beschreibungen seitenübergreifend eindeutig
    for label, seen in (("Titel", titles), ("Beschreibung", descriptions)):
        for text, where in seen.items():
            if len(where) > 1:
                short = text if len(text) <= 60 else text[:57] + "…"
                finding(f"{label} \"{short}\" auf {len(where)} Seiten: {_examples(where)}")

    print()
    if findings:
        print(f"{findings} Befund(e).")
        return 1
    print("Keine Befunde.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
