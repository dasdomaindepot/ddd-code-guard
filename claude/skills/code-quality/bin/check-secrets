#!/usr/bin/env python3
"""check-secrets — Geheimnisse in versionierten Dateien eines Projekts.

Aufgerufen vom Code Guard (Check "secrets"), lässt sich aber auch allein fahren:
    check-secrets [projektverzeichnis]      # Standard: aktuelles Verzeichnis

Geprüft werden nur versionierte Dateien (`git ls-files`); es wird nichts am
Projekt verändert. Es wird niemals ein Geheimniswert ausgegeben, nur Datei,
Zeile und Regelname.

Prüfungen:
    S1  versionierte lokale .env-Dateien (.env.local, .env.<name>.local)
    S2  echter APP_SECRET in versionierter .env
    S3  gitleaks über die versionierten Dateien
    S4  Repo-Hygiene — versionierte Build-Artefakte, persönlicher IDE-Zustand
        und Betriebssystem-Attribute (.DS_Store, Thumbs.db)

Exit-Codes:
     0  keine Befunde
     1  Befunde
     2  Nutzungsfehler (mehr als ein Argument, Verzeichnis existiert nicht)
    77  nicht messbar (kein Git-Repo im Projekt)
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile


findings = 0
hints = 0



# Stabile Regel-ID der gerade laufenden Prüfung (#1957). Sie steht vor jeder
# BEFUND- und Hinweis-Zeile, damit Befunde über Läufe vergleichbar sind und
# Ausnahmen gezielt auf eine Regel zeigen können.
CHECK_ID = "secrets"
RULE = ""


def _rid() -> str:
    rid = f"{CHECK_ID}/{RULE}" if RULE else CHECK_ID
    # Für tests/rule-coverage.sh: welche Regel hat im Testlauf ausgelöst?
    log = os.environ.get("GUARD_RULE_LOG")
    if log:
        try:
            with open(log, "a", encoding="utf-8") as f:
                f.write(rid + "\n")
        except OSError:
            pass
    return f"[{rid}] "

def finding(msg: str) -> None:
    msg = _rid() + msg
    global findings
    findings += 1
    print(f"BEFUND   {msg}")


def ok(msg: str) -> None:
    print(f"ok       {msg}")


def hint(msg: str) -> None:
    msg = _rid() + msg
    global hints
    hints += 1
    print(f"Hinweis  {msg}")


# --- Hilfsfunktionen ---------------------------------------------------

def _read_text(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def relative(project_path: str, path: str) -> str:
    return os.path.relpath(path, project_path)


def _git_ls_files(project_path: str):
    """Versionierte Dateien relativ zum Projekt (split an \0)."""

    proc = subprocess.run(
        ["git", "-C", project_path, "ls-files", "-z"],
        capture_output=True,
    )
    if proc.returncode != 0:
        return []
    parts = proc.stdout.decode("utf-8", errors="surrogateescape").split("\0")
    return [p for p in parts if p]


def _gitleaks_available():
    """Gibt ("lokal") zurück, wenn gitleaks im PATH ist, ("docker"), wenn das
    Image lokal vorhanden ist, sonst None."""

    if shutil.which("gitleaks") is not None:
        return "lokal"
    try:
        inspect = subprocess.run(
            ["docker", "image", "inspect", "zricethezav/gitleaks:latest"],
            capture_output=True, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if inspect.returncode == 0:
        return "docker"
    return None


def _last_app_secret(text: str):
    """Letzte APP_SECRET-Zuweisung in .env-Text (optional `export `, ohne
    Anführungszeichen). Tupel (wert, zeile) oder (None, None)."""

    value = None
    line_no = None
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].strip()
        m = re.match(r"APP_SECRET\s*=\s*(.*)$", line)
        if not m:
            continue
        val = m.group(1).strip()
        if len(val) >= 2 and val[0] in ("\"", "'") and val[-1] == val[0]:
            val = val[1:-1]
        value = val
        line_no = lineno
    return value, line_no


# --- S1: versionierte lokale .env-Dateien ------------------------------

def part_s1_local_envs(project_path: str, files: list) -> None:
    global RULE
    RULE = "S1"
    before = findings
    for rel in files:
        base = os.path.basename(rel)
        if base.endswith(".local") and base.startswith(".env."):
            finding(
                f"{rel} ist versioniert — lokale Geheimnisse gehören nicht ins "
                "Repo; git rm --cached und in .gitignore eintragen"
            )
    if findings == before:
        ok("S1: keine versionierten lokalen .env-Dateien")


# --- S2: echter APP_SECRET in versionierter .env -----------------------

def part_s2_app_secret(project_path: str, files: list) -> None:
    global RULE
    RULE = "S2"
    hinted = 0
    for rel in files:
        base = os.path.basename(rel)
        if not base.startswith(".env"):
            continue
        # .env oder .env.<name>, aber nicht .env.local / *.local
        remainder = base[len(".env"):]
        # .env.test und .env.dev tragen laut Symfony-Rezept absichtlich feste
        # Werte fuer Test und Entwicklung -- dort ist ein APP_SECRET kein Leck.
        if remainder in (".test", ".dev"):
            continue
        if remainder == "":
            pass
        elif remainder.startswith(".") and not remainder.endswith(".local"):
            pass
        else:
            continue
        text = _read_text(os.path.join(project_path, rel))
        if text is None:
            continue
        value, line_no = _last_app_secret(text)
        if value is None:
            continue
        lowered = value.lower()
        if (
            value == ""
            or any(kw in lowered for kw in (
                "change", "secret", "xxx", "placeholder", "%env", "${",
            ))
        ):
            continue
        hinted += 1
        hint(
            f"{rel}:{line_no}: APP_SECRET steht mit echtem Wert im Repo — in .env "
            "leer lassen und nur in .env.local bzw. der Deploy-Variable setzen"
        )
    if hinted == 0:
        ok("S2: APP_SECRET leer oder Platzhalter")


# --- S3: gitleaks über die versionierten Dateien -----------------------

def part_s3_gitleaks(project_path: str, files: list) -> None:
    global RULE
    RULE = "S3"
    mode = _gitleaks_available()
    if mode is None:
        hint("gitleaks nicht verfügbar — Teil S3 nicht gemessen")
        return

    tmp = tempfile.TemporaryDirectory()
    try:
        dest = tmp.name
        # .gitleaksignore mitkopieren, auch wenn sie nicht versioniert ist.
        local_gitleaksignore = os.path.join(project_path, ".gitleaksignore")
        if os.path.isfile(local_gitleaksignore):
            shutil.copy2(local_gitleaksignore, os.path.join(dest, ".gitleaksignore"))
        for rel in files:
            if rel.startswith("vendor/") or rel.startswith("node_modules/"):
                continue
            src = os.path.join(project_path, rel)
            if not os.path.isfile(src):
                continue
            target = os.path.join(dest, rel)
            os.makedirs(os.path.dirname(target), exist_ok=True) \
                if os.path.dirname(rel) else None
            shutil.copy2(src, target)

        if mode == "lokal":
            cmd = [
                "gitleaks", "dir", ".",
                "--no-banner", "--redact", "--log-level", "error",
                "--report-format", "json", "--report-path", "-",
            ]
        else:
            cmd = [
                "docker", "run", "--rm",
                "-v", f"{dest}:/scan:ro", "-w", "/scan",
                "zricethezav/gitleaks:latest",
                "dir", ".",
                "--no-banner", "--redact", "--log-level", "error",
                "--report-format", "json", "--report-path", "-",
            ]
        # Ein Absturz endete mit Exit 1 und saehe im Guard aus wie ein Befund.
        # Alles, was die Messung verhindert, ist deshalb ein Hinweis.
        try:
            proc = subprocess.run(
                cmd, cwd=dest, capture_output=True, timeout=300,
            )
        except (OSError, subprocess.TimeoutExpired):
            hint("gitleaks-Lauf fehlgeschlagen — Teil S3 nicht gemessen")
            return
        raw = proc.stdout.decode("utf-8", errors="replace").strip()
        # gitleaks: Exit 0 = nichts gefunden, 1 = Treffer, alles andere = Fehler.
        if proc.returncode not in (0, 1):
            hint("gitleaks-Lauf fehlgeschlagen — Teil S3 nicht gemessen")
            return
        if not raw or raw in ("null",):
            ok("gitleaks: keine Geheimnisse in den versionierten Dateien")
            return
        try:
            results = json.loads(raw)
        except json.JSONDecodeError:
            results = None
        if not isinstance(results, list):
            hint("gitleaks-Lauf fehlgeschlagen — Teil S3 nicht gemessen")
            return

        reported = 0
        for r in results:
            if not isinstance(r, dict):
                continue
            rule = r.get("RuleID")
            filename = r.get("File", "")
            start = r.get("StartLine", "?")
            fingerprint = r.get("Fingerprint", "")
            if rule == "generic-api-key" and os.path.basename(filename).startswith(".env"):
                continue
            reported += 1
            if rule == "generic-api-key":
                hint(
                    f"{filename}:{start}: gitleaks generic-api-key — prüfen; "
                    f"bewusste Ausnahme per .gitleaksignore (Fingerprint {fingerprint})"
                )
                continue
            finding(
                f"{filename}:{start}: gitleaks {rule} — Geheimnis im Repo; "
                f"widerrufen/rotieren und entfernen, bewusste Ausnahme per "
                f".gitleaksignore (Fingerprint {fingerprint})"
            )
        if reported == 0:
            ok("gitleaks: keine Geheimnisse in den versionierten Dateien")
    finally:
        tmp.cleanup()


# --- S4: Repo-Hygiene — Build-Artefakte, IDE-Zustand, OS-Attribute ------

def part_s4_repo_hygiene(project_path: str, files: list) -> None:
    global RULE
    RULE = "S4"
    findings_before = findings
    hints_before = hints
    build_prefixes = ("vendor/", "node_modules/", "var/cache/", "var/log/", "public/build/")

    # --- Build-Artefakte: Befund je Verzeichnis (nicht je Datei) ---------
    prefix_counts: dict = {p: 0 for p in build_prefixes}
    for rel in files:
        for prefix in build_prefixes:
            if rel.startswith(prefix):
                prefix_counts[prefix] += 1
                break
    for prefix in build_prefixes:
        count = prefix_counts[prefix]
        if count:
            finding(
                f"{prefix} ist versioniert ({count} Dateien) — Build-Artefakt, "
                "in .gitignore aufnehmen und git rm -r --cached"
            )

    # --- persönlicher IDE-Zustand mit absoluten Home-Pfaden --------------
    ide_files = (".idea/workspace.xml", ".idea/tasks.xml", ".vscode/settings.json")
    for rel in files:
        if rel in ide_files or rel.startswith(".idea/shelf/"):
            text = _read_text(os.path.join(project_path, rel))
            if text is None:
                continue
            if "/home/" in text or "C:\\Users" in text:
                hint(f"{rel}: persönlicher IDE-Zustand versioniert")

    # --- Betriebssystem-Attribute ---------------------------------------
    markers = (".DS_Store", "Thumbs.db")
    for rel in files:
        if os.path.basename(rel) in markers:
            hint(
                f"{rel}: {os.path.basename(rel)} ist ein Betriebssystem-Attribut "
                "— nicht im Repository; in .gitignore aufnehmen"
            )

    if findings == findings_before and hints == hints_before:
        ok(
            "S4: kein Build-Artefakt, OS-Attribut oder persönlicher IDE-Zustand "
            "versioniert"
        )


# --- Hauptprogramm -----------------------------------------------------

def main() -> int:
    if len(sys.argv) > 2:
        print("Verwendung: check-secrets [projektverzeichnis]", file=sys.stderr)
        return 2

    project_path = os.path.abspath(sys.argv[1] if len(sys.argv) == 2 else ".")
    if not os.path.isdir(project_path):
        print(f"{project_path}: Verzeichnis existiert nicht", file=sys.stderr)
        return 2

    git_dir = subprocess.run(
        ["git", "-C", project_path, "rev-parse", "--git-dir"],
        capture_output=True,
    )
    if git_dir.returncode != 0:
        print("kein Git-Repo — nicht messbar.")
        return 77

    files = _git_ls_files(project_path)

    part_s1_local_envs(project_path, files)
    part_s2_app_secret(project_path, files)
    part_s3_gitleaks(project_path, files)
    part_s4_repo_hygiene(project_path, files)

    print()
    if findings:
        print(f"{findings} Befund(e).")
        return 1
    print("Keine Befunde.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
