#!/usr/bin/env python3
"""check-versions — Supportende von PHP/Symfony und veraltete Abhängigkeiten.

Aufgerufen vom Code Guard (Check "versions"), lässt sich aber auch allein fahren:
    check-versions [projektverzeichnis]      # Standard: aktuelles Verzeichnis

V1 prüft das Supportende von PHP und Symfony an Hand von endoflife.date: Ein
abgelaufener oder kurz vor dem Ablauf stehener Lauf bekommt einen Befund bzw.
Hinweis. V2 ruft `composer outdated --direct --major-only` im php-Container und
weist auf veraltete Hauptversionen hin (nie ein Befund).

Endoflife-Daten werden aus GUARD_EOL_DIR (Test), sonst aus dem 7-Tage-Cache
`~/.cache/code-guard/endoflife-<produkt>.json` oder, falls nicht vorhanden oder
veraltet, aus dem Netz (urllib, User-Agent "code-guard", 15 s Timeout) bezogen.
`composer outdated` läuft nur im laufenden php-Container; für den Test kann
GUARD_OUTDATED_JSON eine JSON-Datei statt des Aufrufs liefern.

Exit-Codes:
    0  keine Befunde
    1  Befunde
    2  Nutzungsfehler (mehr als ein Argument, Verzeichnis existiert nicht)
   77  nicht messbar (kein composer.json, weder PHP- noch Symfony-Version
       bestimmbar, oder keine Supportdaten verfügbar)
"""

import datetime
import json
import os
import re
import subprocess
import sys
import time

import urllib.request

findings = 0


def finding(msg: str) -> None:
    global findings
    findings += 1
    print(f"BEFUND   {msg}")


def ok(msg: str) -> None:
    print(f"ok       {msg}")


def hint(msg: str) -> None:
    print(f"Hinweis  {msg}")


# --- Hilfsfunktionen ---------------------------------------------------

def _read_text(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def _read_json(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def _write_json(path: str, data) -> None:
    try:
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f)
    except OSError:
        pass


def _today() -> datetime.date:
    tod = os.environ.get("GUARD_TODAY")
    if tod:
        try:
            return datetime.date.fromisoformat(tod)
        except ValueError:
            pass
    return datetime.date.today()


def _major(version) -> int | None:
    if not isinstance(version, str):
        return None
    v = version[1:] if version.startswith("v") else version
    m = re.match(r"(\d+)", v)
    return int(m.group(1)) if m else None


# --- V1: Supportende von PHP und Symfony (endoflife.date) --------------

PHP_DOCKERFILE_CANDIDATES = ("Dockerfile",)


def _php_dockerfile_lines(project_path: str):
    """Zeilen aller PHP-Dockerfiles (Wurzel-Dockerfile + Dockerfile* unter docker/)."""

    candidates = []
    root = os.path.join(project_path, "Dockerfile")
    if os.path.isfile(root):
        candidates.append(root)
    docker_dir = os.path.join(project_path, "docker")
    if os.path.isdir(docker_dir):
        for dirpath, _dirnames, filenames in os.walk(docker_dir):
            for name in filenames:
                if name.startswith("Dockerfile"):
                    candidates.append(os.path.join(dirpath, name))
    for path in candidates:
        text = _read_text(path)
        if text is not None:
            yield path, text


def detect_php(project_path: str):
    """PHP-Haupt/Neben aus dem PHP-Dockerfile, sonst config.platform.php.

    Gibt die Version als "X.Y" zurück, sonst None.
    """

    for _path, text in _php_dockerfile_lines(project_path):
        for line in text.splitlines():
            s = line.strip()
            if not s.upper().startswith("FROM "):
                continue
            m = re.search(r"php:(\d+\.\d+)", s)
            if m:
                return m.group(1)
    composer = _read_json(os.path.join(project_path, "composer.json"))
    if isinstance(composer, dict):
        platform = composer.get("config", {}).get("platform", {})
        if isinstance(platform, dict) and isinstance(platform.get("php"), str):
            pm = re.match(r"(\d+\.\d+)", platform["php"])
            if pm:
                return pm.group(1)
    return None


def detect_symfony(project_path: str):
    """Symfony-Haupt/Neben aus symfony/framework-bundle in composer.lock.

    Gibt "X.Y" zurück, sonst None.
    """

    lock = _read_json(os.path.join(project_path, "composer.lock"))
    if not isinstance(lock, dict):
        return None
    for section in ("packages", "packages-dev"):
        for pkg in lock.get(section, []) or []:
            if not isinstance(pkg, dict):
                continue
            if pkg.get("name") == "symfony/framework-bundle":
                vm = re.match(r"v?\s*(\d+\.\d+)", str(pkg.get("version", "")))
                if vm:
                    return vm.group(1)
    return None


def _extract_releases(data):
    """result.releases als {name: objekt}-Dictionary; sonst None."""

    if not isinstance(data, dict):
        return None
    result = data.get("result")
    if not isinstance(result, dict):
        return None
    releases = result.get("releases")
    if not isinstance(releases, list):
        return None
    out = {}
    for rel in releases:
        if isinstance(rel, dict) and isinstance(rel.get("name"), str):
            out[rel["name"]] = rel
    return out if out else None


def _fetch_eol(produkt):
    """JSON-Antwort von endoflife.date holen; im Fehlerfall None."""

    url = f"https://endoflife.date/api/v1/products/{produkt}"
    req = urllib.request.Request(url, headers={"User-Agent": "code-guard"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        # Jeder Netz-/Decodierfehler: caller entscheidet aus Cache oder Hinweis.
        return None


def _cache_path(produkt: str) -> str:
    cache_dir = os.path.join(os.path.expanduser("~"), ".cache", "code-guard")
    return os.path.join(cache_dir, f"endoflife-{produkt}.json")


def _load_from_cache_or_network(produkt: str):
    """(releases, status). status: 'ok', 'stale' (alter Cache), 'none'."""

    cache_path = _cache_path(produkt)
    cached = _read_json(cache_path)
    if cached is not None:
        releases = _extract_releases(cached)
        if releases is not None:
            fresh = False
            try:
                fresh = (time.time() - os.path.getmtime(cache_path)) < 7 * 24 * 3600
            except OSError:
                fresh = False
            if fresh:
                return releases, "ok"
            fetched = _fetch_eol(produkt)
            if fetched is not None:
                _write_json(cache_path, fetched)
                r = _extract_releases(fetched)
                return r, "ok"
            return releases, "stale"
    fetched = _fetch_eol(produkt)
    if fetched is not None:
        _write_json(cache_path, fetched)
        return _extract_releases(fetched), "ok"
    return None, "none"


def _load_eol(produkt: str):
    """(releases, status). Liest aus GUARD_EOL_DIR (Test), sonst Cache/Netz."""

    eol_dir = os.environ.get("GUARD_EOL_DIR")
    if eol_dir:
        releases = _extract_releases(_read_json(os.path.join(eol_dir, produkt + ".json")))
        return releases, "ok" if releases else "none"
    return _load_from_cache_or_network(produkt)


def _evaluate_product(label: str, version: str, releases, today: datetime.date) -> None:
    rel = releases.get(version) if isinstance(releases, dict) else None
    if rel is None:
        hint(f"{label} {version} bei endoflife.date unbekannt")
        return
    eol_from = rel.get("eolFrom")
    is_eol = rel.get("isEol")
    eol_date = None
    if isinstance(eol_from, str):
        try:
            eol_date = datetime.date.fromisoformat(eol_from)
        except ValueError:
            eol_date = None
    if is_eol is True or (eol_date is not None and eol_date < today):
        date_str = eol_from if eol_from else "unbekannt"
        finding(
            f"{label} {version} bekommt seit {date_str} keine Sicherheitsupdates "
            "mehr (Quelle: endoflife.date) — auf eine unterstützte Version heben"
        )
    elif eol_date is not None and 0 <= (eol_date - today).days < 183:
        hint(f"{label} {version} verliert am {eol_from} den Support")
    else:
        ok(f"{label} {version}: unterstützt bis {eol_from}")


def run_v1(project_path: str, today: datetime.date):
    """V1 ausführen. Gibt 77 zurück, wenn das Projekt nicht messbar ist."""

    php_version = detect_php(project_path)
    sym_version = detect_symfony(project_path)
    if php_version is None and sym_version is None:
        print("keine PHP- und Symfony-Version bestimmbar — nicht messbar.")
        return 77

    products = []
    if php_version is not None:
        products.append(("PHP", php_version))
    if sym_version is not None:
        products.append(("Symfony", sym_version))

    loaded = []
    any_data = False
    for label, version in products:
        releases, status = _load_eol(label.lower())
        if releases is not None:
            any_data = True
        loaded.append((label, version, releases, status))

    if not any_data:
        print("Supportdaten von endoflife.date nicht verfügbar — nicht messbar.")
        return 77

    for label, version, releases, status in loaded:
        if releases is None:
            hint("endoflife.date nicht erreichbar – Supportende nicht geprüft")
            continue
        if status == "stale":
            cache_date = None
            try:
                cache_date = datetime.date.fromtimestamp(os.path.getmtime(_cache_path(label.lower())))
            except OSError:
                pass
            if cache_date is not None:
                hint(f"Supportdaten vom {cache_date.isoformat()}, endoflife.date nicht erreichbar")
        _evaluate_product(label, version, releases, today)

    return None


# --- V2: Veraltete Direktabhängigkeiten (composer outdated) ------------

def _container_php_running(project_path: str) -> bool:
    try:
        out = subprocess.run(
            ["docker", "compose", "ps", "--services", "--filter", "status=running"],
            cwd=project_path,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    services = {line.strip() for line in out.stdout.splitlines()}
    return "php" in services


def _composer_outdated(project_path: str):
    """(installed-Liste, None) oder (None, Grund). Liest GUARD_OUTDATED_JSON
    oder ruft composer im laufenden php-Container."""

    env_file = os.environ.get("GUARD_OUTDATED_JSON")
    if env_file:
        data = _read_json(env_file)
        if isinstance(data, dict):
            return data.get("installed") or [], None
        return None, "Testdatei nicht lesbar"

    if not _container_php_running(project_path):
        return None, "php-Container läuft nicht"
    try:
        out = subprocess.run(
            [
                "docker", "compose", "exec", "-T", "php", "composer", "outdated",
                "--direct", "--major-only", "--format=json", "--no-interaction",
            ],
            cwd=project_path,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except subprocess.TimeoutExpired:
        return None, "composer outdated lief in den Timeout"
    except (OSError, subprocess.SubprocessError):
        return None, "docker compose nicht aufrufbar"
    if out.returncode != 0:
        return None, f"composer outdated endete mit Exit {out.returncode}"
    # Die Ausgabe ist JSON-Text, kein Dateipfad.
    try:
        data = json.loads(out.stdout)
    except (ValueError, TypeError):
        return None, "Ausgabe von composer outdated ist kein JSON"
    if not isinstance(data, dict):
        return None, "Ausgabe von composer outdated ist kein JSON-Objekt"
    return data.get("installed") or [], None


def part_v2_outdated(project_path: str) -> None:
    installed, grund = _composer_outdated(project_path)
    if installed is None:
        hint(f"composer outdated nicht gelaufen ({grund})")
        return

    items = []
    for pkg in installed:
        if not isinstance(pkg, dict):
            continue
        name = pkg.get("name")
        version = pkg.get("version")
        latest = pkg.get("latest")
        if not isinstance(name, str):
            continue
        if _major(latest) is not None and _major(version) is not None and _major(latest) > _major(version):
            items.append((name, version, latest))

    for name, version, latest in items[:10]:
        hint(f"{name} {version} → {latest} (neue Hauptversion)")
    remaining = len(items) - 10
    if remaining > 0:
        hint(f"… und {remaining} weitere")


# --- Hauptprogramm -----------------------------------------------------

def main() -> int:
    if len(sys.argv) > 2:
        print("Verwendung: check-versions [projektverzeichnis]", file=sys.stderr)
        return 2

    project_path = os.path.abspath(sys.argv[1] if len(sys.argv) == 2 else ".")
    if not os.path.isdir(project_path):
        print(f"{project_path}: Verzeichnis existiert nicht", file=sys.stderr)
        return 2

    if not os.path.isfile(os.path.join(project_path, "composer.json")):
        print("kein composer.json — nicht messbar.")
        return 77

    rc = run_v1(project_path, _today())
    if rc == 77:
        return 77

    part_v2_outdated(project_path)

    print()
    if findings:
        print(f"{findings} Befund(e).")
        return 1
    print("Keine Befunde.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
