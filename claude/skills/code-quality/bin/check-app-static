#!/usr/bin/env python3
"""check-app-static — Sicherheits-Check einer Web-App (Symfony oder JS/TS-Frontend).

Aufgerufen vom Code Guard (Check "app-static"), lässt sich aber auch allein fahren:
    check-app-static <projektverzeichnis>      # Standard: aktuelles Verzeichnis

Geprüft werden nur Dateien; es wird nichts gestartet oder aufgerufen.

Befunde (führen zu Exit 1) gibt es nur für Symfony-Projekte (es existiert config/packages/):
    S1 Session-Cookie-Konfiguration (ASVS 3.3.1)
    S2 CSRF-Schutz (ASVS 3.5.1)
    S3 Datei-Uploads mit Größen- und Typbegrenzung (ASVS 5.2.1, 5.2.2)
    S4 .dockerignore beim ganzen Projekt-COPY (ASVS 13.4.1)
     S5 gefährliche Produktions-/Debug-Konfiguration (Session-Fixation,
        Profiler/Debug-Bundle, Debug-Modus in Produktion)
       S6 Geldbeträge, die als float gespeichert sind (Rundungsfehler)
       S7 öffentlich cachebare Antwort in geschütztem Controller (ASVS 5.4)
     S8 Docker-Images: feste Image-Versionen, keine Secrets in ENV/ARG,
        kein Lauf als root (außerhalb des Symfony-Blocks, immer geprüft)
      S9 nginx-Config unter docker/ (server_tokens, Upload-Verzeichnisse,
         client_max_body_size) (außerhalb des Symfony-Blocks, immer geprüft)
     S10 Platzhalter in Übersetzungsdateien (.yaml/.yml): weichen die
        Platzhalter einer Sprache von der Referenzsprache ab (de/en, sonst
        erste Locale alphabetisch)
    


Hinweise (kein Einfluss auf den Exit):
    H1 Rohes SQL mit eingesetzter Variable (ASVS 1.2.4)
    H2 |raw in Twig (ASVS 1.2.1)
    H3 Schwache Kryptografie (ASVS 11.4.1, 11.3.1)
    H4 Gefährliche Funktionen (ASVS 1.2.5, 1.3.2)
    H5 Fokus und Bewegung in CSS (WCAG 2.4.7, 2.3.3)
     H6 TypeScript-Strictness und neue Funktionen im Frontend
      H7 HTTP-Requests ohne Timeout (Symfony http-client, Guzzle-Client,
         file_get_contents)
      H8 PHP-Sicherheits-Patzer: @-Fehlerunterdrückung, json_decode ohne
         JSON_THROW_ON_ERROR, Typcast auf Request-Eingaben
 

Exit-Codes:
    0  keine Befunde
    1  Befunde
    2  Nutzungsfehler (mehr als ein Argument, Verzeichnis existiert nicht)
   77  nicht messbar (weder composer.json noch package.json vorhanden)
"""

import fnmatch
import glob
import json
import os
import re
import sys

try:
    import yaml
except ImportError:
    print("PyYAML fehlt — nicht messbar.")
    sys.exit(77)

# Tags wie !php/const oder !tagged_iterator in Symfony-YAML sind für uns
# irrelevant; wir ersetzen sie durch None, damit safe_load nicht abstürzt.
class _Loader(yaml.SafeLoader):
    pass


def _any_tag(loader, suffix, node):
    return None


_Loader.add_multi_constructor("!", _any_tag)

findings = 0



# Stabile Regel-ID der gerade laufenden Prüfung (#1957). Sie steht vor jeder
# BEFUND- und Hinweis-Zeile, damit Befunde über Läufe vergleichbar sind und
# Ausnahmen gezielt auf eine Regel zeigen können.
CHECK_ID = "app-static"
RULE = ""


def _rid() -> str:
    rid = f"{CHECK_ID}/{RULE}" if RULE else CHECK_ID
    # Für tests/rule-coverage.sh: welche Regel hat im Testlauf ausgelöst?
    log = os.environ.get("GUARD_RULE_LOG")
    if log:
        try:
            with open(log, "a", encoding="utf-8") as f:
                f.write(rid + "\n")
        except OSError:
            pass
    return f"[{rid}] "

def finding(msg: str) -> None:
    msg = _rid() + msg
    global findings
    findings += 1
    print(f"BEFUND   {msg}")


def ok(msg: str) -> None:
    print(f"ok       {msg}")


def hint(msg: str) -> None:
    msg = _rid() + msg
    print(f"Hinweis  {msg}")


# --- Hilfsfunktionen ---------------------------------------------------

def load_top_level_yaml(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return yaml.load(f, Loader=_Loader)
    except (OSError, yaml.YAMLError):
        return None


def load_top_level_json(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def _read_text(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        # Binaer- oder Latin-1-Dateien sind fuer keine Regel relevant; ein
        # Absturz saehe im Guard aus wie ein Befund.
        return None


def php_files_under_src(project_path: str):
    src = os.path.join(project_path, "src")
    result = []
    if not os.path.isdir(src):
        return result
    for root, dirs, files in os.walk(src):
        rel_root = os.path.relpath(root, project_path)
        if "DataFixtures" in rel_root.split(os.sep):
            continue
        for name in files:
            if name.endswith(".php"):
                result.append(os.path.join(root, name))
    return result


def relative(project_path: str, path: str) -> str:
    return os.path.relpath(path, project_path)


def _split_call(text: str, open_index: int) -> str:
    """Vom Index der öffnenden Klammer bis zur passenden schließenden Klammer."""
    depth = 0
    for i in range(open_index, len(text)):
        ch = text[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return text[open_index:i + 1]
    return text[open_index:]


def _call_has(text: str, name: str, needle: str) -> bool:
    for m in re.finditer(re.escape(name) + r"\s*\(", text):
        if needle in _split_call(text, m.end() - 1):
            return True
    return False


def _is_comment_line(line: str) -> bool:
    s = line.strip()
    return (
        s.startswith("//")
        or s.startswith("#")
        or s.startswith("/*")
        or s.startswith("*/")
        or s.startswith("*")
    )


def _strip_strings(line: str) -> str:
    # Anführungszeichen-Inhalte entfernen, damit @ und Klammern innerhalb von
    # Strings (z. B. 'a@b.de' oder "json") die Regex-Erkennung nicht stören.
    line = re.sub(r"'(?:[^'\\]|\\.)*'", "''", line)
    line = re.sub(r'"(?:[^"\\]|\\.)*"', '""', line)
    return line


def _walk_skip(root: str, suffixes: tuple) -> list:
    skip = ("node_modules", "vendor", "public", "var", ".git")
    result = []
    if not os.path.isdir(root):
        return result
    for r, dirs, files in os.walk(root):
        rel = os.path.relpath(r, root)
        parts = [] if rel == "." else rel.split(os.sep)
        if any(p in skip for p in parts):
            continue
        dirs[:] = [d for d in dirs if d not in skip]
        for f in files:
            if f.endswith(suffixes):
                result.append(os.path.join(r, f))
    return result


# --- S1: Session-Cookies -----------------------------------------------

def part_s1_session(project_path: str) -> None:
    global RULE
    RULE = "S1"
    doc = load_top_level_yaml(os.path.join(project_path, "config", "packages", "framework.yaml"))
    framework = doc.get("framework") if isinstance(doc, dict) else None
    session = framework.get("session") if isinstance(framework, dict) else None
    here = []
    if isinstance(session, dict):
        if session.get("cookie_secure") is False:
            here.append("framework.session.cookie_secure: false — auf auto setzen")
        if "cookie_samesite" in session and session["cookie_samesite"] in (None, "none"):
            here.append(
                f"framework.session.cookie_samesite: {session['cookie_samesite']} "
                f"— auf lax setzen"
            )
    if here:
        for m in here:
            finding(m)
    else:
        ok("Session-Cookies: secure und samesite nach Symfony-Standard")


# --- S2: CSRF ----------------------------------------------------------

def part_s2_csrf(project_path: str) -> None:
    global RULE
    RULE = "S2"
    here = []
    fw = load_top_level_yaml(os.path.join(project_path, "config", "packages", "framework.yaml"))
    framework = fw.get("framework") if isinstance(fw, dict) else None
    if isinstance(framework, dict) and framework.get("csrf_protection") is False:
        here.append("framework.csrf_protection: false — CSRF-Schutz für Formulare aktiv lassen")
    sec = load_top_level_yaml(os.path.join(project_path, "config", "packages", "security.yaml"))
    secroot = sec.get("security") if isinstance(sec, dict) else None
    firewalls = secroot.get("firewalls") if isinstance(secroot, dict) else None
    if isinstance(firewalls, dict):
        for name, f in firewalls.items():
            if not isinstance(f, dict) or name.startswith("when@") or f.get("security") is False:
                continue
            fl = f.get("form_login")
            if isinstance(fl, dict) and fl.get("enable_csrf") is False:
                here.append(f"Firewall {name}: form_login mit enable_csrf: false")
    # Einzelne Formulare können den Schutz in configureOptions() abschalten.
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None or "csrf_protection" not in text:
            continue
        # GET-Formulare (Suche, Filter) verändern nichts und brauchen keinen Token.
        if re.search(r"""['"]method['"]\s*=>\s*['"]GET['"]""", text, re.IGNORECASE):
            continue
        for mm in re.finditer(r"""['"]csrf_protection['"]\s*=>\s*false""", text):
            line = text.count("\n", 0, mm.start()) + 1
            here.append(f"{relative(project_path, path)}:{line}: Formular schaltet csrf_protection ab")
    if here:
        for m in here:
            finding(m)
    else:
        ok("CSRF-Schutz aktiv (csrf_protection und form_login)")


# --- S3: Datei-Uploads -------------------------------------------------

def part_s3_uploads(project_path: str) -> None:
    global RULE
    RULE = "S3"
    here = []
    count = 0
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        line_no = None
        for i, line in enumerate(text.splitlines(), 1):
            if "FileType::class" in line:
                line_no = i
                break
        if line_no is None:
            continue
        count += 1
        has_file = _call_has(text, "File", "maxSize")
        has_image = _call_has(text, "Image", "maxSize")
        if not (has_file or has_image):
            here.append(
                f"{relative(project_path, path)}:{line_no}: FileType "
                f"ohne File-Constraint mit maxSize"
            )
        elif not (has_image and not has_file) and "mimeTypes" not in text:
            here.append(
                f"{relative(project_path, path)}:{line_no}: File-Constraint ohne mimeTypes"
            )
    if here:
        for m in here:
            finding(m)
    elif count == 1:
        ok("Datei-Uploads mit Größen- und Typbegrenzung (1 Formular)")
    else:
        ok(f"Datei-Uploads mit Größen- und Typbegrenzung ({count} Formulare)")


# --- S4: .dockerignore -------------------------------------------------

def _whole_copy_line(path: str):
    lines = _read_text(path)
    if lines is None:
        return None
    for i, line in enumerate(lines.splitlines(), 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        parts = s.split()
        if len(parts) >= 2 and parts[0].upper() == "COPY" and parts[1] in (".", "./"):
            return i
    return None


def _find_dockerfiles(project_path: str):
    results = []
    if not os.path.isdir(project_path):
        return results
    for root, dirs, files in os.walk(project_path):
        rel_root = os.path.relpath(root, project_path)
        parts = [] if rel_root == "." else rel_root.split(os.sep)
        if any(p in ("node_modules", "vendor", "public", "var", ".git") for p in parts):
            continue
        dirs[:] = [d for d in dirs if d not in ("node_modules", "vendor", "public", "var")]
        for f in files:
            if f == "Dockerfile" and len(parts) + 1 <= 3:
                p = os.path.join(root, f)
                results.append((p, _whole_copy_line(p)))
    return results


def part_s4_dockerignore(project_path: str) -> None:
    global RULE
    RULE = "S4"
    whole = [(p, ln) for (p, ln) in _find_dockerfiles(project_path) if ln is not None]
    if not whole:
        ok("kein Dockerfile mit 'COPY .' — kein .dockerignore nötig")
        return
    di = None
    di_path = os.path.join(project_path, ".dockerignore")
    if os.path.isfile(di_path):
        di = [l.strip() for l in _read_text(di_path).splitlines()]
    need_git = True
    need_env = True
    if di is not None:
        for l in di:
            if l in (".git", ".git/", "/.git") or fnmatch.fnmatch(l, "**/.git"):
                need_git = False
            if l in (".env.local", "/.env.local") or fnmatch.fnmatch(l, ".env*.local") \
                    or fnmatch.fnmatch(l, ".env.*"):
                need_env = False
    here = []
    p, ln = whole[0]
    if need_git:
        here.append(
            f".dockerignore schließt .git nicht aus — COPY . in "
            f"{relative(project_path, p)}:{ln} kopiert das Repository ins Image"
        )
    if need_env:
        here.append(
            f".dockerignore schließt .env.local nicht aus — COPY . in "
            f"{relative(project_path, p)}:{ln} kopiert das Repository ins Image"
        )
    if here:
        for m in here:
            finding(m)
    else:
        ok(".dockerignore schließt .git und .env.local aus")


# --- S5: Gefährliche Produktions-/Debug-Konfiguration ------------------

def _require_dev_psr4_prefixes(project_path: str) -> dict:
    """Zu jedem require-dev-Paket die psr-4-Klassenpräfixe aus composer.lock.

    Gibt ein Dict {paketname: [präfixe]} zurück; ohne composer.lock leer.
    """
    composer = load_top_level_json(os.path.join(project_path, "composer.json"))
    dev_packages = []
    if isinstance(composer, dict):
        dev = composer.get("require-dev")
        if isinstance(dev, dict):
            dev_packages = list(dev.keys())
    if not dev_packages:
        return {}
    lock = load_top_level_json(os.path.join(project_path, "composer.lock"))
    if not isinstance(lock, dict):
        return {}
    result = {}
    for pkg in lock.get("packages-dev", []) or []:
        if not isinstance(pkg, dict):
            continue
        name = pkg.get("name")
        if name not in dev_packages:
            continue
        prefixes = []
        autoload = pkg.get("autoload")
        if isinstance(autoload, dict):
            psr4 = autoload.get("psr-4")
            if isinstance(psr4, dict):
                for prefix in psr4.keys():
                    if isinstance(prefix, str):
                        prefixes.append(prefix)
        result[name] = prefixes
    return result


def _env_file_debug_in_prod(text: str) -> bool:
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = re.match(r"APP_ENV\s*=\s*(\S+)", s)
        if m and m.group(1).lower() == "dev":
            return True
        m = re.match(r"APP_DEBUG\s*=\s*(\S+)", s)
        if m and m.group(1) in ("1", "true", "True", "TRUE"):
            return True
    return False


def _dockerfile_debug_in_prod(text: str) -> bool:
    stages = []
    current = None
    for raw in text.splitlines():
        s = raw.strip()
        if s.upper().startswith("FROM "):
            current = {"prod_named": False, "env": []}
            stages.append(current)
            m = re.search(r"FROM\s+\S+\s+AS\s+(\S+)", s, re.IGNORECASE)
            if m and "prod" in m.group(1).lower():
                current["prod_named"] = True
        elif current is not None:
            current["env"].append(s)
    if not stages:
        return False
    if len(stages) == 1:
        prod_envs = stages[0]["env"]
    else:
        prod_envs = [env for st in stages if st["prod_named"] for env in st["env"]]
    for env in prod_envs:
        body = re.sub(r"^ENV\s+", "", env, flags=re.IGNORECASE)
        if re.match(r"APP_ENV\s*=\s*dev\b", body, re.IGNORECASE):
            return True
        if re.match(r"APP_DEBUG\s*=\s*(1|true)\b", body, re.IGNORECASE):
            return True
    return False


def part_s5_prod_config(project_path: str) -> None:
    global RULE
    RULE = "S5"
    here = []

    # 1. Session-Fixation (nur Top-Level security:, nicht when@…)
    sec = load_top_level_yaml(os.path.join(project_path, "config", "packages", "security.yaml"))
    secroot = sec.get("security") if isinstance(sec, dict) else None
    if isinstance(secroot, dict):
        if "session_fixation_strategy" in secroot \
                and secroot["session_fixation_strategy"] in (None, "none"):
            here.append(
                "Session-ID wird beim Login nicht erneuert (Session Fixation); "
                "Standard migrate verwenden"
            )
        firewalls = secroot.get("firewalls")
        if isinstance(firewalls, dict):
            for name, fw in firewalls.items():
                if not isinstance(fw, dict) or name.startswith("when@") \
                        or "session_fixation_strategy" not in fw:
                    continue
                if fw["session_fixation_strategy"] in (None, "none"):
                    here.append(
                        f"Firewall {name}: Session-ID wird beim Login nicht "
                        f"erneuert (Session Fixation); Standard migrate verwenden"
                    )

    # 2 + 3. Profiler/Debug- und require-dev-Bundles in bundles.php
    prefixes_by_package = _require_dev_psr4_prefixes(project_path)
    bundles_text = _read_text(os.path.join(project_path, "config", "bundles.php"))
    if bundles_text is not None:
        for line in bundles_text.splitlines():
            m = re.match(r"^\s*([A-Za-z0-9_\\]+)::class\s*=>\s*\[(.*)\]", line)
            if not m:
                continue
            bundle = m.group(1)
            options = m.group(2)
            is_all = re.search(r"['\"]all['\"]\s*=>\s*true", options) is not None
            is_prod = re.search(r"['\"]prod['\"]\s*=>\s*true", options) is not None
            if not (is_all or is_prod):
                continue
            if "WebProfilerBundle" in bundle or "DebugBundle" in bundle:
                here.append(
                    f"Profiler/Debug in Produktion aktiv ({bundle})"
                )
            if is_all and prefixes_by_package:
                for package, prefixes in prefixes_by_package.items():
                    for prefix in prefixes:
                        if bundle.startswith(prefix):
                            here.append(
                                f"{bundle} kommt aus require-dev ({package}), "
                                f"ist aber für all aktiv — die App startet mit "
                                f"composer install --no-dev nicht; auf "
                                f"['dev' => true, 'test' => true] beschränken"
                            )

    # 4. Debug-Modus in Produktion (.env.prod oder Produktionsstufe)
    debug_source = None
    prod_env_path = os.path.join(project_path, ".env.prod")
    if os.path.isfile(prod_env_path):
        env_text = _read_text(prod_env_path)
        if env_text is not None and _env_file_debug_in_prod(env_text):
            debug_source = relative(project_path, prod_env_path)
    dockerfiles = []
    root_dockerfile = os.path.join(project_path, "Dockerfile")
    if os.path.isfile(root_dockerfile):
        dockerfiles.append(root_dockerfile)
    dockerfiles += glob.glob(
        os.path.join(project_path, "docker", "**", "Dockerfile*"), recursive=True
    )
    for df in dockerfiles:
        df_text = _read_text(df)
        if df_text is not None and _dockerfile_debug_in_prod(df_text):
            debug_source = relative(project_path, df)
            break
    if debug_source is not None:
        here.append(
            f"Produktion läuft im Debug-Modus (Stacktraces, Profiler) — "
            f"{debug_source}"
        )

    if here:
        for m in here:
            finding(m)
    else:
        ok("Produktions-Konfiguration: kein Debug, Session-Fixation-Schutz aktiv")


# --- S6: Geldbetrige als float -----------------------------------------

# Wortteile im Property-Namen, die auf einen Geldbetrag hinden.
MONEY_PARTS = ("price", "amount", "total", "cost", "fee", "preis",
               "betrag", "summe", "netto", "brutto", "gebuehr", "gebühr")
# Namen mit diesen Wortteilen sind keine Geldbeträge (Raten, Gewichte, ...).
MONEY_EXCLUSIONS = ("rate", "percent", "prozent", "quote", "weight", "gewicht")
# Doctrine-Type-Marker, die auf float schlieBen lassen.
FLOAT_ANNOTATION_RE = re.compile(
    r"type\s*:\s*'float'|type\s*:\s*Types::FLOAT|type\s*=\s*['\"]float['\"]"
)
# Property-Deklaration mit Sichtbarkeit und Variablenname.
PROP_RE = re.compile(
    r"\b(?:private|protected|public)\b[^;]*\$(\w+)\s*(?::|=|;)"
)


def _is_money_name(name: str) -> bool:
    low = name.lower()
    if not any(part in low for part in MONEY_PARTS):
        return False
    return not any(excl in low for excl in MONEY_EXCLUSIONS)


def part_s6_money_float(project_path: str) -> None:
    global RULE
    RULE = "S6"
    here = []
    total = 0
    shown = 0
    for path in php_files_under_src(project_path):
        if "Entity" not in os.path.relpath(path, project_path).split(os.sep):
            continue
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        lines = text.splitlines()
        for idx, line in enumerate(lines):
            m = PROP_RE.search(line)
            if not m:
                continue
            name = m.group(1)
            if not _is_money_name(name):
                continue
            is_float = re.search(r"\b\??float\b", line) is not None
            if not is_float:
                window = lines[max(0, idx - 5):idx]
                if any(FLOAT_ANNOTATION_RE.search(l) for l in window):
                    is_float = True
            if not is_float:
                continue
            total += 1
            if shown < 10:
                here.append(
                    f"{rel}:{idx + 1}: Geldbetrag {name} als float — "
                    f"Rundungsfehler; decimal (string) oder Ganzzahl in Cent verwenden"
                )
                shown += 1
    if here:
        for msg in here:
            finding(msg)
        if total > 10:
            hint(f"… und {total - 10} weitere Geldbeträge als float")
    else:
        ok("Geldbeträge in Entity-Properties: keine als float")


# --- S7: Öffentlich cachebare Antwort in geschütztem Controller ----------

# Response-Aufrufe, die eine Antwort öffentlich (shared) markieren und vom
# Reverse-Proxy auch für nicht-authentifizierte Nutzer zwischengespeichert
# werden darf. Nur die zeilenbasierten Marker; das #[Cache]-Attribut mit
# public: true wird separat über die ganze Klammer geprüft.
CACHE_LINE_RE = re.compile(
    r"setPublic\(|setSharedMaxAge\(|addCacheControlDirective\(\s*['\"]public['\"]"
    r"|smaxage:"
)


def part_s7_public_cache(project_path: str) -> None:
    global RULE
    RULE = "S7"
    here = []
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        # Geschützt: Attribut, Aufruf oder Session-Nutzung markieren die Datei.
        if not (
            "#[IsGranted(" in text
            or "denyAccessUnlessGranted(" in text
            or "->getUser()" in text
        ):
            continue
        rel = relative(project_path, path)
        flagged = set()
        lines = text.splitlines()
        for idx, line in enumerate(lines, 1):
            if CACHE_LINE_RE.search(line) or "smaxage:" in line:
                flagged.add(idx)
        # #[Cache(public: true)] — public kann auf einer anderen Zeile stehen,
        # daher die ganze Klammer bis zur schließenden Klammer prüfen.
        for m in re.finditer(r"#\[Cache\s*\(", text):
            call = _split_call(text, m.end() - 1)
            if "public: true" in call:
                flagged.add(text.count("\n", 0, m.start()) + 1)
        for ln in sorted(flagged):
            here.append(
                f"{rel}:{ln}: öffentlich cachebare Antwort in einem "
                f"geschützten Controller — ein Reverse-Proxy liefert sie an "
                f"andere Nutzer aus; private/no_store verwenden"
            )
    if here:
        for m in here:
            finding(m)
    else:
        ok("Öffentlich cachebare Antworten: keine in geschützten Controllern")


# --- S10: Platzhalter in Übersetzungsdateien -----------------------------

# %name% — Symfony-Platzhalter in Prozentzeichen (kein %s/%d von sprintf: die
# tragen kein abschließendes %).
PCT_PLACEHOLDER_RE = re.compile(r"%([A-Za-z_][A-Za-z0-9_]*)%")
# {name} (einfacher Platzhalter) oder {name, …} (ICU-Argument). Gefangen wird
# nur der Name direkt nach der öffnenden Klammer, gefolgt von } oder , — damit
# Wörter innerhalb von Zweigen wie „one {# Eintrag}” nicht erfasst werden; die
# # markiert eine ICU-Zahl und ist kein Platzhalter.
BRACE_PLACEHOLDER_RE = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)[},]")


def _flatten_yaml(data: dict, prefix: str = "", out: dict = None) -> dict:
    """Verschachtelte Schlüssel zu a.b.c flach machen; nur String-Werte."""
    if out is None:
        out = {}
    for key, value in data.items():
        if not isinstance(key, str):
            continue
        full = f"{prefix}.{key}" if prefix else key
        if isinstance(value, dict):
            _flatten_yaml(value, full, out)
        elif isinstance(value, str):
            out[full] = value
    return out


def _extract_placeholders(value: str) -> list:
    """Menge der Platzhalter eines Wertes als Liste (Literal wie %name% / {name})."""
    result = []
    for m in PCT_PLACEHOLDER_RE.finditer(value):
        result.append(f"%{m.group(1)}%")
    for m in BRACE_PLACEHOLDER_RE.finditer(value):
        result.append(f"{{{m.group(1)}}}")
    return result


def _domain_locale(filename: str):
    """(Domain, Locale) aus <domain>.<locale>.yaml bzw. <domain>+intl-icu.<locale>.yaml."""
    name = os.path.basename(filename)
    base = name[:-5] if name.endswith(".yaml") else name[:-4]
    if "+intl-icu" in base:
        domain, _, locale = base.partition("+intl-icu")
    else:
        domain, _, locale = base.rpartition(".")
    if not domain or not locale:
        return None, None
    return domain, locale


def part_s10_translation_placeholders(project_path: str) -> None:
    global RULE
    RULE = "S10"
    translations_dir = os.path.join(project_path, "translations")
    if not os.path.isdir(translations_dir):
        ok("keine Übersetzungsdateien (.yaml/.yml) — S10 entfällt")
        return
    files = [
        os.path.join(translations_dir, name)
        for name in sorted(os.listdir(translations_dir))
        if name.endswith((".yaml", ".yml"))
    ]

    # {domain: {locale: {key: value}}} plus rel-Pfad je (domain, locale).
    data = {}
    paths = {}
    for path in files:
        domain, locale = _domain_locale(path)
        if domain is None or locale is None:
            continue
        doc = load_top_level_yaml(path)
        if not isinstance(doc, dict):
            continue
        data.setdefault(domain, {})[locale] = _flatten_yaml(doc)
        paths[(domain, locale)] = relative(project_path, path)

    if not data:
        ok("keine gültigen Übersetzungsdateien (.yaml/.yml) — S10 entfällt")
        return

    all_findings = []
    for domain in sorted(data):
        locales = data[domain]
        if "de" in locales:
            ref_locale = "de"
        elif "en" in locales:
            ref_locale = "en"
        else:
            ref_locale = sorted(locales)[0]
        ref = locales[ref_locale]
        for other_locale in sorted(locales):
            if other_locale == ref_locale:
                continue
            other = locales[other_locale]
            rel = paths[(domain, other_locale)]
            for key in sorted(ref):
                if key not in other:
                    continue
                ref_ph = set(_extract_placeholders(ref[key]))
                other_ph = set(_extract_placeholders(other[key]))
                if ref_ph == other_ph:
                    continue
                extra = sorted(other_ph - ref_ph)
                missing = sorted(ref_ph - other_ph)
                if extra and missing:
                    msg = (
                        f"{rel}: {key} hat {', '.join(extra)} "
                        f"statt {', '.join(missing)} (Referenz {ref_locale})"
                    )
                elif extra:
                    msg = (
                        f"{rel}: {key} hat {', '.join(extra)} "
                        f"(Referenz {ref_locale})"
                    )
                else:
                    msg = (
                        f"{rel}: {key} fehlt "
                        f"{', '.join(missing)} (Referenz {ref_locale})"
                    )
                all_findings.append(msg)

    if all_findings:
        for msg in all_findings[:15]:
            finding(msg)
        if len(all_findings) > 15:
            hint(f"… und {len(all_findings) - 15} weitere")
    else:
        ok("Übersetzungen: keine Platzhalter-Abweichungen zwischen den Sprachen")


# --- S8: Docker-Images hartnen -----------------------------------------

# Namen, die auf ein im Image verstecktes Geheimnis hinweisen.
SECRET_KEYWORDS = ("PASSWORD", "PASSWD", "SECRET", "TOKEN", "API_KEY", "PRIVATE_KEY")


def _is_dockerfile_name(name: str) -> bool:
    """Wahr, wenn „Dockerfile“ ein eigener Bestandteil des Namens ist
    (Dockerfile, Dockerfile.dev, dev.Dockerfile, ...)."""
    parts = re.split(r"[._-]", name)
    return "Dockerfile" in parts


def _is_dev_dockerfile(name: str) -> bool:
    """Dockerfiles mit .dev-Suffix oder „dev“ als Namensteil überspringen."""
    if name.endswith(".dev"):
        return True
    parts = [p.lower() for p in re.split(r"[._-]", name)]
    return "dev" in parts


def _is_named_prod(name: str) -> bool:
    n = name.lower()
    return n in ("prod", "production") or n.endswith("_prod")


def _dockerfiles_for_hardening(project_path: str) -> list:
    results = []
    if not os.path.isdir(project_path):
        return results
    root_df = os.path.join(project_path, "Dockerfile")
    if os.path.isfile(root_df):
        results.append(root_df)
    docker_dir = os.path.join(project_path, "docker")
    if os.path.isdir(docker_dir):
        skip = ("node_modules", "vendor", "public", "var", ".git")
        for root, dirs, files in os.walk(docker_dir):
            dirs[:] = [d for d in dirs if d not in skip]
            for f in files:
                if _is_dockerfile_name(f):
                    results.append(os.path.join(root, f))
    return results


def _dockerfile_tag(image: str):
    """Tag aus dem Image-Ref (nach dem letzten Slash); None, wenn keiner."""
    last = image.rsplit("/", 1)[-1]
    if ":" in last:
        return last.split(":", 1)[1]
    return None


def _dockerfile_name(image: str) -> str:
    """Image-Name ohne Tag zur Ausgabe."""
    last = image.rsplit("/", 1)[-1]
    return last.split(":", 1)[0]


def _parse_env_arg(line: str):
    """(Verb, Name, Wert) aus einer ENV-/ARG-Zeile; bei leerem Wert Wert = ''."""
    m = re.match(r"(ENV|ARG)\s+(.*)", line, re.IGNORECASE)
    if not m:
        return (None, None, None)
    verb = m.group(1).upper()
    body = m.group(2).strip()
    if not body:
        return (verb, None, None)
    if "=" in body:
        name, value = body.split("=", 1)
        name = name.strip()
        value = value.strip()
    else:
        parts = body.split(None, 1)
        name = parts[0].strip()
        value = parts[1].strip() if len(parts) > 1 else ""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
        value = value[1:-1]
    return (verb, name, value)


def _check_one_dockerfile(project_path: str, path: str) -> None:
    text = _read_text(path)
    if text is None:
        return
    rel = relative(project_path, path)
    stages = []
    current = None
    for lineno, raw in enumerate(text.splitlines(), 1):
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        if re.match(r"FROM\s", s, re.IGNORECASE):
            current = {"name": None, "image": None, "line": lineno,
                       "env": [], "users": []}
            stages.append(current)
            m = re.match(r"FROM\s+(?:--\S+\s+)*(\S+)(?:\s+AS\s+(\S+))?",
                         s, re.IGNORECASE)
            if m:
                current["image"] = m.group(1)
                current["name"] = m.group(2)
        elif current is not None:
            if re.match(r"(ENV|ARG)\b", s, re.IGNORECASE):
                current["env"].append((lineno, s))
            elif re.match(r"USER\b", s, re.IGNORECASE):
                um = re.match(r"USER\s+(\S+)", s)
                if um:
                    current["users"].append(um.group(1))
    if not stages:
        ok(f"{rel}: kein FROM — Image nicht prüfbar")
        return

    # 1. Basis-Image ohne feste Version (außer scratch / frühere Stufe).
    prev = set()
    for st in stages:
        img = st["image"]
        if img is not None and img.lower() != "scratch" and img not in prev:
            tag = _dockerfile_tag(img)
            if tag == "latest" or tag is None:
                reason = "latest" if tag == "latest" else "kein Tag"
                finding(
                    f"{rel}:{st['line']}: Basis-Image "
                    f"{_dockerfile_name(img)} ohne feste Version ({reason}) "
                    f"— Builds sind nicht reproduzierbar"
                )
        if st["name"]:
            prev.add(st["name"])

    # 2. Feste Secrets in ENV/ARG irgendeiner Stufe.
    for st in stages:
        for lineno, eline in st["env"]:
            verb, name, value = _parse_env_arg(eline)
            if name is None or value == "":
                continue
            if not any(k in name.upper() for k in SECRET_KEYWORDS):
                continue
            if value.startswith("$"):
                continue
            finding(
                f"{rel}:{lineno}: {verb} {name} mit festem Wert im Image — "
                f"landet in jeder Kopie des Images; zur Laufzeit übergeben"
            )

    # 3. Produktionsstufe ohne USER oder als root.
    prod_index = len(stages) - 1
    for i, st in enumerate(stages):
        if st["name"] and _is_named_prod(st["name"]):
            prod_index = i
            break
    users = stages[prod_index]["users"]
    if not users or users[-1].split(":")[0] in ("root", "0"):
        hint("Container läuft als root; USER www-data "
             "(bzw. nicht privilegierter Benutzer) setzen")


def part_s8_docker_hardening(project_path: str) -> None:
    global RULE
    RULE = "S8"
    candidates = [
        d for d in _dockerfiles_for_hardening(project_path)
        if not _is_dev_dockerfile(os.path.basename(d))
    ]
    if not candidates:
        ok("kein Dockerfile: S8 entfällt")
        return
    for df in candidates:
        _check_one_dockerfile(project_path, df)


# --- S9: nginx-Serverkonfiguration -------------------------------------

# Upload-Verzeichnisse: Namen unter public/, die typischerweise hochgeladene
# Dateien enthalten und nicht nach PHP durchsucht werden sollen.
UPLOAD_DIR_NAMES = ("upload", "uploads", "media", "files")
# server_tokens off; mit beliebigemwhitespace vor dem Semikolon.
SERVER_TOKENS_OFF_RE = re.compile(r"server_tokens\s+off\s*;")
# client_max_body_size 20M; — mit einem Wert dazwischen.
CLIENT_MAX_BODY_SIZE_RE = re.compile(r"client_max_body_size\s+\S+;")
# Eine location-Zeile: „location" am Zeilenanfang (nach Whitespace).
LOCATION_LINE_RE = re.compile(r"\s*location\s")
# Front-Controller: das location-Muster verweist auf index.php.
FRONT_CONTROLLER_RE = re.compile(r"index", re.IGNORECASE)


def _read_nginx_configs(project_path: str) -> list:
    """Alle *.conf und nginx.conf*-Dateien unter docker/ (rekursiv), mit
    Zeilenkommentaren (# bis Zeilenende) entfernt. Liest unlesbare Dateien als
    leer und stürzt nicht ab."""
    docker_dir = os.path.join(project_path, "docker")
    if not os.path.isdir(docker_dir):
        return []
    skip = ("node_modules", "vendor", "public", "var", ".git")
    texts = []
    for root, dirs, files in os.walk(docker_dir):
        dirs[:] = [d for d in dirs if d not in skip]
        for name in sorted(files):
            if not (name.endswith(".conf") or name.startswith("nginx.conf")):
                continue
            raw = _read_text(os.path.join(root, name))
            if raw is None:
                continue
            cleaned = []
            for line in raw.splitlines():
                hash_pos = line.find("#")
                if hash_pos != -1:
                    line = line[:hash_pos]
                cleaned.append(line)
            texts.append("\n".join(cleaned))
    return texts


def _nginx_location_blocks(text: str) -> list:
    """Komplette location-Blöcke (Kopf bis zur schließenden Klammer)."""
    blocks = []
    for m in re.finditer(r"location\b[^\{]*\{", text):
        brace = m.end() - 1
        depth = 0
        for i in range(brace, len(text)):
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
                if depth == 0:
                    blocks.append(text[m.start():i + 1])
                    break
    return blocks


def _has_general_php_location(config_texts: list) -> bool:
    """Wahr, wenn fastcgi_pass in einem location steht, der kein Front-
    Controller (index.php) ist und damit beliebige .php-Dateien ausführen kann."""
    for t in config_texts:
        for block in _nginx_location_blocks(t):
            if "fastcgi_pass" in block and FRONT_CONTROLLER_RE.search(block) is None:
                return True
    return False


def _is_upload_protected(config_text: str, dir_name: str) -> bool:
    """Wahr, wenn der Verzeichnisname in einer location-Zeile vorkommt und in
    derselben oder den nächsten 5 Zeilen „deny all“ oder „return 40“ steht."""
    lines = config_text.splitlines()
    dir_re = re.compile(re.escape(dir_name))
    for i, line in enumerate(lines):
        if LOCATION_LINE_RE.match(line) and dir_re.search(line):
            window = lines[i:i + 6]
            if any(("deny all" in w) or ("return 40" in w) for w in window):
                return True
    return False


def _upload_dir_names(project_path: str) -> list:
    """Aufzählung existierender Upload-Verzeichnisse unter public/."""
    public_dir = os.path.join(project_path, "public")
    if not os.path.isdir(public_dir):
        return []
    names = []
    for entry in sorted(os.listdir(public_dir)):
        if entry in UPLOAD_DIR_NAMES \
                and os.path.isdir(os.path.join(public_dir, entry)):
            names.append(entry)
    return names


def _project_has_filetype(project_path: str) -> bool:
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is not None and "FileType::class" in text:
            return True
    return False


def part_s9_nginx(project_path: str) -> None:
    global RULE
    RULE = "S9"
    config_texts = _read_nginx_configs(project_path)
    if not config_texts:
        ok("keine nginx-Konfiguration: S9 entfällt")
        return
    produced = False

    if not any(SERVER_TOKENS_OFF_RE.search(t) for t in config_texts):
        hint("nginx verrät seine Version (server_tokens off setzen)")
        produced = True

    if _has_general_php_location(config_texts):
        combined = "\n".join(config_texts)
        for name in _upload_dir_names(project_path):
            if not _is_upload_protected(combined, name):
                finding(
                    f"public/{name}: PHP-Dateien darin würden ausgeführt "
                    f"(ASVS 5.3.1) — location-Block mit deny für *.php"
                )
                produced = True

    client_has = any(CLIENT_MAX_BODY_SIZE_RE.search(t) for t in config_texts)
    if _project_has_filetype(project_path) and not client_has:
        hint(
            "nginx begrenzt Uploads auf 1 MB (Standard); "
            "client_max_body_size passend zu den maxSize-Constraints setzen"
        )
        produced = True

    if not produced:
        ok("nginx-Konfiguration: geprüft, keine Schwächen erkannt")


# --- H1: Rohes SQL -----------------------------------------------------

# Alle DBAL-/PDO-Aufrufe, die SQL als ersten Parameter nehmen. Geprüft wird der
# ganze Aufruf bis zur schließenden Klammer, nicht nur die Zeile: Doctrine-Code
# verteilt SQL fast immer über mehrere Zeilen.
SQL_CALL_RE = re.compile(
    r"(?:->|::)(executeQuery|executeStatement|query|exec|prepare|createNativeQuery|createQuery"
    r"|fetchAllAssociative|fetchAssociative|fetchAllNumeric|fetchNumeric|fetchOne"
    r"|fetchFirstColumn|fetchAllKeyValue|fetchAllAssociativeIndexed|iterateAssociative)\s*\("
)
SQL_TAINT_RE = re.compile(r"""("[^"]*\$\w|['"]\s*\.\s*\$\w|\$\w[\w\->\[\]'"]*\s*\.\s*['"])""")


def part_h1_sql(project_path: str) -> None:
    global RULE
    RULE = "H1"
    total = 0
    shown = 0
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        for m in SQL_CALL_RE.finditer(text):
            call = _split_call(text, m.end() - 1)
            if not SQL_TAINT_RE.search(call):
                continue
            total += 1
            if shown < 10:
                line = text.count("\n", 0, m.start()) + 1
                hint(f"{rel}:{line}: SQL mit eingesetzter Variable — Parameter verwenden")
                shown += 1
    if total > 10:
        hint(f"… und {total - 10} weitere")


# --- H2: |raw in Twig --------------------------------------------------

RAW_RE = re.compile(r"\| ?raw\b")


def part_h2_raw_twig(project_path: str) -> None:
    global RULE
    RULE = "H2"
    templates = os.path.join(project_path, "templates")
    if not os.path.isdir(templates):
        return
    twigs = glob.glob(os.path.join(templates, "**", "*.twig"), recursive=True)
    total = 0
    templ_count = 0
    hits = []
    for path in twigs:
        text = _read_text(path)
        if text is None:
            continue
        templ_count += 1
        for i, line in enumerate(text.splitlines(), 1):
            for _ in RAW_RE.finditer(line):
                total += 1
                hits.append((relative(project_path, path), i))
    if total > 0:
        hint(
            f"{total}× |raw in {templ_count} Templates — jede Stelle braucht "
            f"bereinigtes HTML (z. B. html_sanitizer)"
        )
        for rel, i in hits[:5]:
            hint(f"{rel}:{i}: |raw — unsicheres HTML, bereinigtes verwenden (z. B. html_sanitizer)")


# --- H3: Schwache Kryptografie -----------------------------------------

def part_h3_crypto(project_path: str) -> None:
    global RULE
    RULE = "H3"
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        for i, line in enumerate(text.splitlines(), 1):
            low = line.lower()
            m = re.search(r"\b(md5|sha1)\s*\(", low)
            if m and any(k in low for k in ("token", "password", "passwort", "secret", "hash")):
                hint(
                    f"{rel}:{i}: {m.group(1)} für Sicherheitszwecke — "
                    f"random_bytes/password_hash/hash('sha256') verwenden"
                )
                continue
            m = re.search(r"\b(rand|mt_rand)\s*\(", low)
            if m and any(k in low for k in ("token", "code", "secret", "password")):
                hint(
                    f"{rel}:{i}: {m.group(1)} für Sicherheitszwecke — "
                    f"random_bytes/hash verwenden"
                )
                continue
            if re.search(r"""['"][^'"]*ECB[^'"]*['"]""", line):
                hint(f"{rel}:{i}: ECB-Modus — mit sicherem Modus (z. B. CTR/GCM) verschlüsseln")


# --- H4: Gefährliche Funktionen ----------------------------------------

RAW_FN_RE = re.compile(r"""(?<![\w>:$])(eval|exec|shell_exec|system|passthru|proc_open|popen)\s*\(""")


def part_h4_dangerous(project_path: str) -> None:
    global RULE
    RULE = "H4"
    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        for i, line in enumerate(text.splitlines(), 1):
            for m in RAW_FN_RE.finditer(line):
                hint(f"{rel}:{i}: {m.group(1)} — gefährliche Funktion, durch sichere API ersetzen")
            if "unserialize(" in line and "allowed_classes" not in line:
                hint(f"{rel}:{i}: unserialize ohne allowed_classes — erlaubte Klassen einschränken")


# --- H5: Fokus und Bewegung in CSS -------------------------------------

def part_h5_css_focus(project_path: str) -> None:
    global RULE
    RULE = "H5"
    assets = os.path.join(project_path, "assets")
    if not os.path.isdir(assets):
        return
    has_keyframes = False
    has_reduced = False
    for path in _walk_skip(assets, (".css", ".scss")):
        text = _read_text(path)
        if text is None:
            continue
        # outline:none ist nur ein Problem, wenn kein :focus-visible den Fokus wieder zeigt.
        if ":focus-visible" not in text:
            m = re.search(r"outline\s*:\s*(none|0)\b", text)
            if m:
                line = text.count("\n", 0, m.start()) + 1
                hint(f"{relative(project_path, path)}:{line}: outline:none ohne :focus-visible — Tastaturfokus unsichtbar (WCAG 2.4.7)")
        if "@keyframes" in text or re.search(r"animation\s*:", text):
            has_keyframes = True
        if "prefers-reduced-motion" in text:
            has_reduced = True
    if has_keyframes and not has_reduced:
        hint(
            "Animationen ohne @media (prefers-reduced-motion) — Bewegung für "
            "empfindliche Nutzer abschaltbar machen"
        )


# --- H6: TypeScript ----------------------------------------------------

def part_h6_typescript(project_path: str) -> None:
    global RULE
    RULE = "H6"
    tsconfig = os.path.join(project_path, "tsconfig.json")
    if os.path.isfile(tsconfig):
        raw = _read_text(tsconfig) or ""
        stripped = "\n".join(l.split("//", 1)[0] for l in raw.splitlines())
        try:
            data = json.loads(stripped)
            strict = isinstance(data, dict) and data.get("strict") is True
        except json.JSONDecodeError:
            strict = re.search(r'"strict"\s*:\s*true', raw) is not None
        if not strict:
            hint('tsconfig.json: "strict": true fehlt — striktes Typchecking einschalten')
    assets = os.path.join(project_path, "assets")
    if not os.path.isdir(assets):
        return
    total = 0
    shown = 0
    for path in _walk_skip(assets, (".js", ".ts", ".vue")):
        text = _read_text(path)
        if text is None:
            continue
        for i, line in enumerate(text.splitlines(), 1):
            if re.search(r"\beval\s*\(", line) or "new Function(" in line:
                total += 1
                if shown < 5:
                    hint(f"{relative(project_path, path)}:{i}: eval/new Function — unsichere Code-Ausführung")
                    shown += 1
    if total > 5:
        hint(f"… und {total - 5} weitere")


def _composer_has_package(project_path: str, name: str) -> bool:
    lock = load_top_level_json(os.path.join(project_path, "composer.lock"))
    if not isinstance(lock, dict):
        return False
    for pkg in lock.get("packages", []) or []:
        if isinstance(pkg, dict) and pkg.get("name") == name:
            return True
    return False


# --- H7: HTTP-Requests ohne Timeout ------------------------------------

# new Client( und new \GuzzleHttp\Client( — die optionale Gruppe deckt den
# vollqualifizierten Namen ab, bei aliastem Import bleibt sie leer.
HTTP_CLIENT_CALL_RE = re.compile(r"new\s+(?:\\GuzzleHttp\\)?Client\s*\(")
# file_get_contents('http ... bzw. file_get_contents("http ...
FILE_GET_HTTP_RE = re.compile(r"file_get_contents\(\s*['\"]http")


def part_h7_http_timeouts(project_path: str) -> None:
    global RULE
    RULE = "H7"
    here = []
    total_client = 0
    shown_client = 0
    total_fileget = 0
    shown_fileget = 0

    # Nur bei direkter Abhängigkeit: Indirekt steckt der Client in fast jedem
    # Symfony-Projekt, ohne dass die App selbst HTTP-Aufrufe macht.
    composer = load_top_level_json(os.path.join(project_path, "composer.json"))
    direct = composer.get("require") if isinstance(composer, dict) else None
    if isinstance(direct, dict) and "symfony/http-client" in direct:
        fw = load_top_level_yaml(
            os.path.join(project_path, "config", "packages", "framework.yaml")
        )
        framework = fw.get("framework") if isinstance(fw, dict) else None
        hc = framework.get("http_client") if isinstance(framework, dict) else None
        default_opts = hc.get("default_options") if isinstance(hc, dict) else None
        has_default_timeout = (
            isinstance(default_opts, dict)
            and ("timeout" in default_opts or "max_duration" in default_opts)
        )
        # Auch gar nicht konfiguriert ist „ohne Timeout“ – das ist der häufigste Fall.
        if not has_default_timeout:
            here.append(
                "framework.http_client.default_options ohne timeout/max_duration "
                "— ein langsamer Dienst hält Requests unbegrenzt fest"
            )
        scoped = hc.get("scoped_clients") if isinstance(hc, dict) else None
        if isinstance(scoped, dict) and not has_default_timeout:
            for name in scoped:
                client = scoped.get(name)
                if not isinstance(client, dict) \
                        or "timeout" in client or "max_duration" in client:
                    continue
                here.append(
                    f"framework.http_client.scoped_clients.{name} ohne "
                    "timeout/max_duration — ein langsamer Dienst hält Requests "
                    "unbegrenzt fest"
                )

    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        uses_guzzle = "GuzzleHttp" in text
        for m in (HTTP_CLIENT_CALL_RE.finditer(text) if uses_guzzle else ()):
            if "timeout" in _split_call(text, m.end() - 1):
                continue
            total_client += 1
            if shown_client < 10:
                line = text.count("\n", 0, m.start()) + 1
                here.append(
                    f"{rel}:{line}: HTTP-Client ohne timeout — Timeouts "
                    "konfigurieren (Guzzle 'timeout', Symfony max_duration)"
                )
                shown_client += 1
        for m in FILE_GET_HTTP_RE.finditer(text):
            total_fileget += 1
            if shown_fileget < 10:
                line = text.count("\n", 0, m.start()) + 1
                here.append(
                    f"{rel}:{line}: ohne Timeout und Fehlerbehandlung — "
                    "HTTP-Client verwenden"
                )
                shown_fileget += 1

    if here:
        for m in here:
            hint(m)
    else:
        ok("HTTP-Requests: keine fehlenden Timeouts erkannt")


# --- H8: PHP-Sicherheits-Patzer ----------------------------------------

# @ direkt vor einem Funktionsaufruf (@"$?\w+\s*() oder einer Variablen (@$w+).
# Der Negative-Lookbehind hindert daran, @ nach einem Bezeichner oder
# Anführungszeichen zu treffen; @var/@param/@return landen ohnehin in
# Kommentarzeilen.
AT_SUPPRESS_RE = re.compile(r"(?<![\w'\"])@(?:\$?\w+\s*\(|\$\w+)")
# json_decode( — der ganze Aufruf wird auf JSON_THROW_ON_ERROR geprüft.
JSON_DECODE_RE = re.compile(r"json_decode\s*\(")
# Typcast unmittelbar vor einer Request-Eingabe: (int)/(float)/(bool)/(string)
# vor $request->get(, $request->query->get( oder $request->request->get(.
REQUEST_CAST_RE = re.compile(
    r"\(\s*(?:int|float|bool|string)\s*\)\s*\$request(?:->query|->request)?->get\s*\("
)


def part_h8_php_hints(project_path: str) -> None:
    global RULE
    RULE = "H8"
    suppress_total = 0
    suppress_shown = 0
    json_total = 0
    json_shown = 0
    cast_total = 0
    cast_shown = 0

    for path in php_files_under_src(project_path):
        text = _read_text(path)
        if text is None:
            continue
        rel = relative(project_path, path)
        for i, line in enumerate(text.splitlines(), 1):
            if _is_comment_line(line):
                continue
            code = _strip_strings(line)

            for _ in AT_SUPPRESS_RE.finditer(code):
                suppress_total += 1
                if suppress_shown < 5:
                    hint(f"{rel}:{i}: @-Fehlerunterdrückung versteckt Fehler")
                    suppress_shown += 1

            for m in JSON_DECODE_RE.finditer(code):
                call = _split_call(code, m.end() - 1)
                if "JSON_THROW_ON_ERROR" not in call:
                    json_total += 1
                    if json_shown < 5:
                        hint(
                            f"{rel}:{i}: json_decode ohne JSON_THROW_ON_ERROR "
                            f"— Fehler und gültiges null sind nicht "
                            f"unterscheidbar"
                        )
                        json_shown += 1

            for _ in REQUEST_CAST_RE.finditer(code):
                cast_total += 1
                if cast_shown < 5:
                    hint(
                        f"{rel}:{i}: fehlende Eingabe wird still zu "
                        f"0/''/false — validieren statt casten"
                    )
                    cast_shown += 1

    if suppress_total > 5:
        hint(f"… und {suppress_total - 5} weitere @-Fehlerunterdrückungen")
    if json_total > 5:
        hint(f"… und {json_total - 5} weitere json_decode ohne JSON_THROW_ON_ERROR")
    if cast_total > 5:
        hint(f"… und {cast_total - 5} weitere gecastete Eingaben")


# --- Hauptprogramm -----------------------------------------------------

def main() -> int:
    if len(sys.argv) > 2:
        print("Verwendung: check-app-static [projektverzeichnis]", file=sys.stderr)
        return 2

    project_path = os.path.abspath(sys.argv[1] if len(sys.argv) == 2 else ".")
    if not os.path.isdir(project_path):
        print(f"{project_path}: Verzeichnis existiert nicht", file=sys.stderr)
        return 2

    if not (
        os.path.isfile(os.path.join(project_path, "composer.json"))
        or os.path.isfile(os.path.join(project_path, "package.json"))
    ):
        print("weder composer.json noch package.json — nicht messbar.")
        return 77

    if os.path.isdir(os.path.join(project_path, "config", "packages")):
        part_s1_session(project_path)
        part_s2_csrf(project_path)
        part_s3_uploads(project_path)
        part_s4_dockerignore(project_path)
        part_s5_prod_config(project_path)
        part_s6_money_float(project_path)
        part_s7_public_cache(project_path)
        part_s10_translation_placeholders(project_path)

    part_s8_docker_hardening(project_path)

    part_s9_nginx(project_path)

    part_h1_sql(project_path)
    part_h2_raw_twig(project_path)
    part_h3_crypto(project_path)
    part_h4_dangerous(project_path)
    part_h5_css_focus(project_path)
    part_h6_typescript(project_path)
    part_h7_http_timeouts(project_path)
    part_h8_php_hints(project_path)

    print()
    if findings:
        print(f"{findings} Befund(e).")
        return 1
    print("Keine Befunde.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
